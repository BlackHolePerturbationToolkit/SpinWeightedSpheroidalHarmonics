Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    InterpretationBox[
     TagBox[
      TemplateBox[{"s", "l", "m", "\[Theta]", "\[Phi]"},
       "MyCustomBox",
       DisplayFunction->(StyleBox[
         FrameBox[
          RowBox[{
            SubscriptBox["", #], 
