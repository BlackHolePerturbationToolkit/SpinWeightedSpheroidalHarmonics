Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    InterpretationBox[
     TagBox[
      TemplateBox[{"s", "l", "m", "\[Theta]", "\[Phi]"},
       "MyCustomBox",
       DisplayFunction->(StyleBox[
         FrameBox[
          RowBox[{
            SubscriptBox["", #], 
            SubscriptBox["Y", 
             RowBox[{#2, " ", #3}]], 
            RowBox[{"[", #4, ",", #5, "]"}]}], Background -> None, FrameStyle -> 
          None, RoundingRadius -> 4, FrameMargins -> {{0, 1}, {0, 0}}]]& )],
      DisplayForm],
     SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]], "\[Rule]", 
    RowBox[{
     FractionBox["1", 
      SqrtBox[
       RowBox[{"l", "+", 
        SuperscriptBox["l", "2"], "-", 
        RowBox[{"s", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "s"}], ")"}]}]}]]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"m", "+", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}], "+", 
          RowBox[{"s", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], " ", 
        RowBox[{"Csc", "[", "\[Theta]", "]"}], " ", 
        InterpretationBox[
         TagBox[
          TemplateBox[{
            RowBox[{"1", "+", "s"}], "l", "m", "\[Theta]", "\[Phi]"},
           "MyCustomBox",
           DisplayFunction->(StyleBox[
             FrameBox[
              RowBox[{
                SubscriptBox["", #], 
                SubscriptBox["Y", 
                 RowBox[{#2, " ", #3}]], 
                RowBox[{"[", #4, ",", #5, "]"}]}], Background -> None, 
              FrameStyle -> None, RoundingRadius -> 4, 
              FrameMargins -> {{0, 1}, {0, 0}}]]& )],
          DisplayForm],
         SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[
         1 + $CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\
\[Theta], $CellContext`\[Phi]]]}], "-", 
       RowBox[{
        SqrtBox[
         RowBox[{
          RowBox[{"-", "2"}], "+", "l", "+", 
          SuperscriptBox["l", "2"], "-", 
          RowBox[{"3", " ", "s"}], "-", 
          SuperscriptBox["s", "2"]}]], " ", 
        InterpretationBox[
         TagBox[
          TemplateBox[{
            RowBox[{"2", "+", "s"}], "l", "m", "\[Theta]", "\[Phi]"},
           "MyCustomBox",
