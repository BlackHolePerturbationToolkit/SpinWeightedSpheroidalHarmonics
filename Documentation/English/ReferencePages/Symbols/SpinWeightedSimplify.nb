          Background->None,
          FrameMargins->{{0, 1}, {0, 0}},
          FrameStyle->None],
         SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[
         1 + $CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\
\[Theta], $CellContext`\[Phi]]]}], "-", 
       RowBox[{
        SqrtBox[
         RowBox[{
          RowBox[{"-", "2"}], "+", "l", "+", 
          SuperscriptBox["l", "2"], "-", 
          RowBox[{"3", " ", "s"}], "-", 
          SuperscriptBox["s", "2"]}]], " ", 
        InterpretationBox[
         FrameBox[
          RowBox[{
           SubscriptBox["", 
            RowBox[{"2", "+", "s"}]], 
           SubscriptBox["Y", 
            RowBox[{"l", " \[InvisibleSpace]", "m"}]], 
           RowBox[{"[", "\[Theta]", ",", "\[Phi]", "]"}]}],
          Background->None,
          FrameMargins->{{0, 1}, {0, 0}},
          FrameStyle->None],
         SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[
         2 + $CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\
\[Theta], $CellContext`\[Phi]]]}]}], ")"}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.997356048421699*^9, 3.9973561893978148`*^9}, 
   3.998375580476894*^9, {3.998390344261503*^9, 3.998390349799814*^9}},
