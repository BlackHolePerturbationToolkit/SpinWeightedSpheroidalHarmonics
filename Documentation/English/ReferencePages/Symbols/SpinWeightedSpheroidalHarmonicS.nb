 CellID->1071590628,ExpressionUUID->"ba675648-2cef-4569-a5d1-38941d74491d"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
    RowBox[{"s", ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], 
   "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        SqrtBox[
         RowBox[{
          SuperscriptBox["l", "2"], "-", 
          SuperscriptBox["m", "2"]}]], " ", "s", " ", 
        SqrtBox[
         RowBox[{
          SuperscriptBox["l", "2"], "-", 
          SuperscriptBox["s", "2"]}]], " ", 
        RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
         RowBox[{"s", ",", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "l"}], ",", "m", ",", "\[Theta]", ",", 
          "\[Phi]"}], "]"}]}], 
       RowBox[{
        SuperscriptBox["l", "2"], " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"2", " ", "l"}]}]], " ", 
        SqrtBox[
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "l"}]}]]}]], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SqrtBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", "l"}], ")"}], "2"], "-", 
           SuperscriptBox["m", "2"]}]], " ", "s", " ", 
         SqrtBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", "l"}], ")"}], "2"], "-", 
           SuperscriptBox["s", "2"]}]], " ", 
         RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
          RowBox[{"s", ",", 
           RowBox[{"1", "+", "l"}], ",", "m", ",", "\[Theta]", ",", 
           "\[Phi]"}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", "l"}], ")"}], "2"], " ", 
         SqrtBox[
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", "l"}], ")"}]}]}]], " ", 
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", "l"}], ")"}]}]}]]}], ")"}]}]}], ")"}], " ", 
    "\[Gamma]"}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Gamma]", "]"}], "2"],
    SeriesData[$CellContext`\[Gamma], 0, {}, 0, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Gamma], 0, {
    SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]], $CellContext`l^(-2) (-1 + 2 $CellContext`l)^
      Rational[-1, 2] (1 + 2 $CellContext`l)^
      Rational[-1, 2] ($CellContext`l^2 - $CellContext`m^2)^
      Rational[1, 2] $CellContext`s ($CellContext`l^2 - $CellContext`s^2)^
      Rational[1, 2] 
     SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, -1 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]] - (1 + $CellContext`l)^(-2) (-1 + 
      2 (1 + $CellContext`l))^Rational[-1, 2] (1 + 2 (1 + $CellContext`l))^
     Rational[-1, 2] ((1 + $CellContext`l)^2 - $CellContext`m^2)^
     Rational[1, 
       2] $CellContext`s ((1 + $CellContext`l)^2 - $CellContext`s^2)^
     Rational[1, 2] 
    SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, 
      1 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]}, 0, 2, 1],
  Editable->False]], "Output",
 CellChangeTimes->{3.990182577586505*^9},
 CellLabel->"Out[101]=",
 CellID->593445538,ExpressionUUID->"08dd7216-a5c5-4838-b4a4-8e0331510133"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

