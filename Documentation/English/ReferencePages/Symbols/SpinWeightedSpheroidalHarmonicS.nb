    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicSFunction"]], "InlineFormula",ExpressionUUID->
  "605e649d-797b-4aec-adc2-86553c0c4497"],
 " which can be evaluated for specific values of ",
 Cell[BoxData[
 "\[Theta]"], "InlineFormula",ExpressionUUID->
  "eba79411-df7f-44bb-ae20-f6aa7f571f0c"],
 " and ",
 Cell[BoxData[
 "\[Phi]"], "InlineFormula",ExpressionUUID->
  "b72e0bf6-9725-4615-a7ee-50acc028ba0f"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"891883f4-6e4f-4cbc-9d7c-e15eeb4685fd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SpinWeightedSpheroidalHarmonicS",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicS"], "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["l", "TI"], ",", 
    StyleBox["m", "TI"], ",", 
    StyleBox["\[Gamma]", "TR"], 
    StyleBox[",", "TR"], 
    StyleBox["\[Theta]", "TR"], ",", 
    StyleBox["\[Phi]", "TR"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7ee65509-9918-42f4-bbea-956b6807e5d5"],
 "\[LineSeparator]gives the spin-weighted spheroidal harmonic ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
    SubscriptBox["S", 
     RowBox[{"l", "m"}]]}], 
   RowBox[{"(", 
    RowBox[{"\[Theta]", ",", "\[Phi]", ";", "\[Gamma]"}], ")"}]}]],
  ExpressionUUID->"40a6ab93-568f-47d6-bca1-5baa27822aa3"],
 ", where the single bracket structure is better suited for series expansions."
