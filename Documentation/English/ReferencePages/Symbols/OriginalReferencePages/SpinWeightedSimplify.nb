Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a45a5b5e-6d0d-49f2-9ecc-f8aeef0918e0"],
 "\!\(\*RowBox[{\"SpinWeightedSimplify\", \"[\", RowBox[{StyleBox[\"expr\", \
\"TI\"], \",\", StyleBox[\"s\", \"TI\"]}], \"]\"}]\) canonicalizes all \
instances of SpinWeightedSphericalHarmonicY and its derivatives by converting \
them to harmonics of spin weight \!\(\*StyleBox[\"s\", \"TR\"]\)."
}], "Usage",
 CellID->1779288678,ExpressionUUID->"e0d7dc40-95db-439c-9068-9eb0487174b2"],

