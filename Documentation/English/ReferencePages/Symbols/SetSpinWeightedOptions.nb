   RowBox[{"\"\<OverloadSeries\>\"", "->", "False"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EchoTiming", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Gamma]", " ", 
