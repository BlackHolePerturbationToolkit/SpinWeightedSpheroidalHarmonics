     RowBox[{
      SubscriptBox["", "s"], 
      SubscriptBox["Y", 
       RowBox[{"\[ScriptL]", " \[InvisibleSpace]", "m"}]], 
      RowBox[{"[", "\[Theta]", ",", "\[Phi]", "]"}]}],
     Background->None,
