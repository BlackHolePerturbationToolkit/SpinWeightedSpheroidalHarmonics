Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"882c01a4-4679-41eb-8580-ec2045326935"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DerivativeToYslm",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SpinWeightedSpheroidalHarmonics/ref/DerivativeToYslm"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "4f467bd3-19a1-4d18-bb16-4ba27b625063"],
 "\[LineSeparator]reduces all \[Theta] Derivatives of ",
 Cell[BoxData[
  ButtonBox["SpinWeightedSphericalHarmonicY",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSphericalHarmonicY"]], "InlineFormula",ExpressionUUID->
  "b2a2b42b-e6a3-49c3-b221-9adf0d5a4f98"],
 " to ",
 Cell[BoxData[
  ButtonBox["SpinWeightedSphericalHarmonicY",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSphericalHarmonicY"]], "InlineFormula",ExpressionUUID->
  "6d91c377-62aa-4fde-9378-6d54686ff5a6"],
 " of different spin weight. It always brings the spin weight closer to 0, \
where assuming that a symbolic s is negative."
}], "Usage",
 CellChangeTimes->{3.9901801906612043`*^9},
