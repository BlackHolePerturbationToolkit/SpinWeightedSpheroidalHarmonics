Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "=", 
      RowBox[{"-", "2"}]}], ",", 
     RowBox[{"l", "=", "2"}], ",", 
     RowBox[{"\[Gamma]", "=", "1.9"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"sSlm", "=", 
        RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
         RowBox[{"s", ",", "l", ",", "m", ",", "\[Gamma]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"SphericalPlot3D", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Re", "[", 
           RowBox[{"sSlm", "[", 
            RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Phi]", ",", 
           RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
         RowBox[{"Mesh", "\[Rule]", "False"}], ",", 
         RowBox[{"Axes", "\[Rule]", "False"}], ",", 
         RowBox[{"Boxed", "\[Rule]", "False"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
         RowBox[{"PlotPoints", "->", "30"}], ",", 
         RowBox[{"BoxRatios", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
         RowBox[{"ColorFunction", "\[Rule]", 
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "x", ",", "y", ",", "z", ",", "\[Theta]", ",", "\[Phi]", ",", 
              "r"}], "}"}], ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", "p", "}"}], ",", 
              RowBox[{
               RowBox[{"p", "=", 
                FractionBox[
                 RowBox[{
                  RowBox[{"Arg", "[", 
                   RowBox[{"Exp", "[", 
                    RowBox[{"\[ImaginaryI]", " ", "m", " ", "\[Phi]"}], "]"}],
                    "]"}], "+", "\[Pi]"}], 
                 RowBox[{"2", "\[Pi]"}]]}], ";", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"p", "<", 
                  RowBox[{"1", "/", "2"}]}], ",", 
                 RowBox[{
                  RowBox[{"ColorData", "[", "\"\<DarkRainbow\>\"", "]"}], "[", 
                  RowBox[{"1", "-", 
                   RowBox[{"2", "p"}]}], "]"}], ",", 
                 RowBox[{
                  RowBox[{"ColorData", "[", "\"\<DarkRainbow\>\"", "]"}], "[", 
                  RowBox[{"1", "-", 
                   RowBox[{"2", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", "p"}], ")"}]}]}], "]"}]}], "]"}]}]}], 
             "]"}]}], "]"}]}], ",", 
         RowBox[{"ColorFunctionScaling", "\[Rule]", "False"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"Opacity", "[", "0.9", "]"}]}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", 
        RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.893871635451354*^9, 3.8938716731449337`*^9}, {
   3.893906908097683*^9, 3.893906911036352*^9}, 3.893907016795641*^9},
 CellLabel->"In[1]:=",
 CellID->1135913679,ExpressionUUID->"07e472ed-0771-402a-a997-ad2db7e7dd1e"]
}, Closed]]
