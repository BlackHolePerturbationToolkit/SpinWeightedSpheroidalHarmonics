Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "0f3b5c5e-4339-4c8b-860f-066e80492cc3"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->2065074653,ExpressionUUID->"f5aa5d10-c729-4679-aef9-fb208ba63d8f"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SpinWeightedSphericalHarmonicY",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSphericalHarmonicY"]], "InlineFormula",ExpressionUUID->
  "6b2e10c5-b71b-47a6-9f95-65539ed27063"],
 " satisfies the identity  ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
     SubscriptBox["Y", 
      RowBox[{"l", "m"}]]}], 
    RowBox[{"(", 
     RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}]}], "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"l", "+", "m"}]], 
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", 
      RowBox[{"-", "s"}]], 
     SubscriptBox["Y", 
      RowBox[{"l", "m"}]]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Pi]", "-", "\[Theta]"}], ",", "\[Phi]"}], ")"}]}]}]],
  ExpressionUUID->"caf6bf96-7791-44cb-a27a-7afb77741da9"]
}], "ExampleText",
 CellChangeTimes->{{3.893911818021254*^9, 3.8939118695704*^9}, {
  3.893998519025453*^9, 3.8939985540746107`*^9}},
 CellID->78990157,ExpressionUUID->"271e032d-985b-4f62-9a3f-7ba6967169cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"s", "=", "2"}], ",", 
      RowBox[{"l", "=", "3"}], ",", 
      RowBox[{"m", "=", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
      RowBox[{"s", ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
      "]"}], "==", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"l", "+", "m"}]], 
      RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
       RowBox[{
        RowBox[{"-", "s"}], ",", "l", ",", "m", ",", 
        RowBox[{"\[Pi]", "-", "\[Theta]"}], ",", "\[Phi]"}], "]"}]}]}]}], 
   "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.893911609507628*^9, 3.893911792391792*^9}, {
  3.8939126693821774`*^9, 3.8939126694979258`*^9}, {3.893998555738519*^9, 
  3.893998712310635*^9}},
 CellLabel->"In[8]:=",
 CellID->1152901163,ExpressionUUID->"3edde19c-cc05-4fb3-9290-619b66f270c1"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9983759911971397`*^9},
 CellLabel->"Out[8]=",
 CellID->1587225803,ExpressionUUID->"3f92b28d-879c-4fb4-9e30-a2e6371787ae"]
}, Open  ]],

Cell[TextData[{
 "It also satisfies the identity  ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
     SubscriptBox["Y", 
      RowBox[{"l", "m"}]]}], 
    RowBox[{"(", 
     RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}]}], "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"l", "+", "s"}]], 
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
     SubscriptBox[
      OverscriptBox["Y", "_"], 
      RowBox[{"l", "-", "m"}]]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Pi]", "-", "\[Theta]"}], ",", "\[Phi]"}], ")"}]}]}]],
  ExpressionUUID->"99714d6b-ed93-42a9-8b8a-5d11005fcf2d"]
}], "ExampleText",
 CellChangeTimes->{{3.893911818021254*^9, 3.893911907432328*^9}, {
  3.893998718922217*^9, 3.893998727739106*^9}, {3.8939988139708023`*^9, 
  3.89399881397086*^9}},
 CellID->1505275450,ExpressionUUID->"25166cb6-d80c-494f-bf48-6e80ee94e00f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "=", "2"}], ",", 
     RowBox[{"l", "=", "3"}], ",", 
     RowBox[{"m", "=", "2"}]}], "}"}], ",", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
       RowBox[{"s", ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
       "]"}], "==", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"l", "+", "s"}]], 
       RowBox[{"Conjugate", "[", 
        RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
         RowBox[{"s", ",", "l", ",", 
          RowBox[{"-", "m"}], ",", 
          RowBox[{"\[Pi]", "-", "\[Theta]"}], ",", "\[Phi]"}], "]"}], 
        "]"}]}]}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{
       RowBox[{"0", "<=", "\[Theta]", "<=", "\[Pi]"}], "&&", 
       RowBox[{"0", "<=", "\[Phi]", "<=", "\[Pi]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.893911609507628*^9, 3.893911792391792*^9}, {
  3.893911914287514*^9, 3.893911953974912*^9}, {3.893912667205648*^9, 
  3.893912667272705*^9}, {3.893998731329183*^9, 3.8939988050808353`*^9}, {
  3.8939988609346237`*^9, 3.893998865146432*^9}},
 CellLabel->"In[9]:=",
 CellID->1807126490,ExpressionUUID->"1b5a7450-962b-4021-b543-1f6d551c0a35"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9983759913149776`*^9},
 CellLabel->"Out[9]=",
 CellID->503166723,ExpressionUUID->"13298efd-cc7c-4a87-aa23-370fde53e541"]
}, Open  ]],

Cell[TextData[{
 "These can be combined to produce the useful identity  ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
     SubscriptBox["Y", 
      RowBox[{"l", "m"}]]}], 
    RowBox[{"(", 
     RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}]}], "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"m", "+", "s"}]], 
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", 
      RowBox[{"-", "s"}]], 
     SubscriptBox[
      OverscriptBox["Y", "_"], 
      RowBox[{"l", "-", "m"}]]}], 
    RowBox[{"(", 
     RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}]}]}]],ExpressionUUID->
  "02606cb9-19ae-4c34-aa7b-fa3fb328e5a8"]
}], "ExampleText",
 CellChangeTimes->{{3.893911818021254*^9, 3.893911907432328*^9}, {
  3.893911971732584*^9, 3.893911997560934*^9}, {3.893998810353978*^9, 
  3.893998820616428*^9}},
 CellID->701152851,ExpressionUUID->"d60dae2c-fe66-4313-9608-3f8361f75817"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "=", "2"}], ",", 
     RowBox[{"l", "=", "3"}], ",", 
     RowBox[{"m", "=", "2"}]}], "}"}], ",", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
       RowBox[{"s", ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
       "]"}], "==", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"m", "+", "s"}]], 
       RowBox[{"Conjugate", "[", 
        RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
         RowBox[{
          RowBox[{"-", "s"}], ",", "l", ",", 
          RowBox[{"-", "m"}], ",", "\[Theta]", ",", "\[Phi]"}], "]"}], 
        "]"}]}]}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{
       RowBox[{"0", "<=", "\[Theta]", "<=", "\[Pi]"}], "&&", 
       RowBox[{"0", "<=", "\[Phi]", "<=", "\[Pi]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.893911609507628*^9, 3.893911792391792*^9}, {
  3.893911914287514*^9, 3.893911953974912*^9}, {3.8939120169137*^9, 
  3.893912026454278*^9}, {3.893912664463529*^9, 3.89391266464359*^9}, {
  3.893998823642441*^9, 3.893998873624518*^9}},
 CellLabel->"In[10]:=",
 CellID->1331131786,ExpressionUUID->"d0236db6-895b-41e9-a930-244da4c9fd53"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.998375991392129*^9},
 CellLabel->"Out[10]=",
 CellID->1623730686,ExpressionUUID->"30f64440-be12-4960-9ef3-28ed47055e33"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "0948905e-89d5-4569-8eb4-00082fa0b76b"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->1679082884,ExpressionUUID->"b1366801-8fc9-4d19-ab3d-5d2a3233e6fa"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SpinWeightedSphericalHarmonicY",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSphericalHarmonicY"]], "InlineFormula",ExpressionUUID->
  "46f473a6-f76a-4b95-83e7-1503296ff3bc"],
 " of different spin-weight are related by spin raising and lower operators. \
These are differential operators ",
 Cell[BoxData[
 "\[ScriptCapitalL]"], "InlineFormula",ExpressionUUID->
  "18c1d473-7629-492a-810d-5aeb308e2a04"],
 " and ",
 Cell[BoxData[
  SuperscriptBox["\[ScriptCapitalL]", "\[Dagger]"]], "InlineFormula",
  ExpressionUUID->"88e78831-6b0e-41fe-b657-b5f051e90ba7"],
 ":"
}], "ExampleText",
 CellChangeTimes->{{3.893911818021254*^9, 3.8939118695704*^9}, {
  3.893918737751254*^9, 3.893918772455801*^9}, {3.893998953417145*^9, 
  3.8939989925788913`*^9}, {3.8939990360739594`*^9, 3.893999045979547*^9}},
 CellID->263426161,ExpressionUUID->"d293c7fd-bbee-4ab0-b1cb-7d2946db1383"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalL]\[Dagger]", "[", 
     RowBox[{"n_", ",", " ", "m_"}], "]"}], "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"x", ",", "\[Theta]"}], "]"}], "-", 
    RowBox[{"m", " ", 
     RowBox[{"Csc", "[", "\[Theta]", "]"}], " ", "x"}], "+", 
    RowBox[{"n", " ", 
     RowBox[{"Cot", "[", "\[Theta]", "]"}], "x"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalL]", "[", 
     RowBox[{"n_", ",", "m_"}], "]"}], "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"x", ",", "\[Theta]"}], "]"}], "+", 
    RowBox[{"m", " ", 
     RowBox[{"Csc", "[", "\[Theta]", "]"}], " ", "x"}], "+", 
    RowBox[{"n", " ", 
     RowBox[{"Cot", "[", "\[Theta]", "]"}], "x"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.89391877509403*^9, 3.893918789087553*^9}, {
  3.893918851365633*^9, 3.893918851857271*^9}, {3.893918909328081*^9, 
  3.893918911297574*^9}, {3.8939988996483183`*^9, 3.893998938057133*^9}, {
  3.893999001744456*^9, 3.893999002244567*^9}},
 CellLabel->"In[11]:=",
 CellID->1737226322,ExpressionUUID->"9ebf1d5d-f9d9-44f7-9a4d-c28c1a0f67d7"],

Cell[TextData[{
 "We raise the spin-weight using ",
 Cell[BoxData[
  SuperscriptBox["\[ScriptCapitalL]", "\[Dagger]"]], "InlineFormula",
  ExpressionUUID->"fb0d65dd-83a5-4cee-b5ed-bfe23846fa93"],
 ":"
}], "ExampleText",
 CellChangeTimes->{{3.893999167132014*^9, 3.893999195066171*^9}},
 CellID->2031827472,ExpressionUUID->"00402eba-933f-43b9-8fd5-3691cfaaa3df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"s", "=", 
       RowBox[{"-", "1"}]}], ",", 
      RowBox[{"l", "=", "1"}], ",", 
      RowBox[{"m", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"\[ScriptCapitalL]\[Dagger]", "[", 
       RowBox[{"1", ",", "m"}], "]"}], "@", 
      RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
       RowBox[{"s", ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
       "]"}]}], "==", 
     RowBox[{
