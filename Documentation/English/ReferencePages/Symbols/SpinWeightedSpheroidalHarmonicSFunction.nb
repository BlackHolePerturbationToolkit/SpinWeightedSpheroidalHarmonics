Cell[TextData[{
 "A ",
 ButtonBox["SpinSpinWeightedSpheroidalHarmonicSFunction",
  BaseStyle->"Link",
  ButtonData->
   "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinSpinWeightedSpheroidalHarmonicSFunction"],
 " may be treated as a numeric function of two arguments, \[Theta] and \[Phi]."
}], "Notes",
 CellChangeTimes->{3.89444433430832*^9},
 CellID->1810327536,ExpressionUUID->"d4f284dd-84f3-4338-bc50-7e352ff9ff74"],

Cell[TextData[{
 "The parameters ",
 Cell[BoxData[
 "s"], "InlineFormula",ExpressionUUID->"6426e54b-e8b4-4fe4-b896-1573bc638c95"],
 ", ",
 Cell[BoxData[
 "l"], "InlineFormula",ExpressionUUID->"00b2d054-ba66-426b-88df-937afda20a6c"],
