Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "2", ",", "m", ",", 
     RowBox[{"a", " ", "\[Omega]"}]}], "]"}], "[", 
   RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}], "//", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{"#", ",", "\[Phi]"}], "]"}], "&"}]}]], "Input",
 CellChangeTimes->{{3.993482421368177*^9, 3.993482460209833*^9}},
 CellLabel->"In[9]:=",
 CellID->1339223360,ExpressionUUID->"dd1d7873-a3f0-46f5-bd67-141a5a9d91f4"],

Cell[BoxData[
 RowBox[{"\[ImaginaryI]", " ", "m", " ", 
  InterpretationBox[
   TagBox[
    TemplateBox[{
      RowBox[{"-", "2"}], "2", "m", 
      RowBox[{"a", " ", "\[Omega]"}], "\[Theta]", "\[Phi]"},
     "MyCustomBox",
     DisplayFunction->(StyleBox[
       FrameBox[
        RowBox[{
          SubscriptBox["", #], 
          SubscriptBox["S", 
           RowBox[{#2, "", #3}]], 
          RowBox[{"[", #4, "]", "[", #5, ",", #6, "]"}]}], Background -> None,
         FrameStyle -> None, RoundingRadius -> 4, 
        FrameMargins -> {{0, 1}, {0, 0}}]]& )],
    DisplayForm],
   SpinWeightedSpheroidalHarmonics`SpinWeightedSpheroidalHarmonicS[-2, 
    2, $CellContext`m, $CellContext`a $CellContext`\[Omega]][$CellContext`\
\[Theta], $CellContext`\[Phi]]]}]], "Output",
 CellChangeTimes->{{3.9934824537875757`*^9, 3.9934824605679092`*^9}},
 CellLabel->"Out[9]=",
 CellID->338765820,ExpressionUUID->"8ad6f873-fcb4-4143-bd81-6af4cb43f15c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "2", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}],
     "]"}], "//", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"#", ",", "\[Theta]"}], "]"}], "&"}]}], "//", 
  RowBox[{"ReplaceAll", "[", 
