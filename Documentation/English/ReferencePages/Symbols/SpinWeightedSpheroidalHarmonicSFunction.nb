Cell[TextData[{
 "Numerical evaluation for specific ",
 Cell[BoxData[
 "\[Theta]"], "InlineFormula",ExpressionUUID->
  "bdee15e2-4ddc-44db-a670-496f98480184"],
 " and ",
 Cell[BoxData[
 "\[Phi]"], "InlineFormula",ExpressionUUID->
  "26abae17-13ea-4c00-8207-02aa4bd2e641"],
