Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"FunctionExpand", "[", 
    RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
     RowBox[{"s", ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}],
     "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"m", ">", "s"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.89378488267599*^9, 3.893784903317453*^9}, 
   3.893785080001985*^9, {3.893835989769261*^9, 3.893835993410424*^9}, {
   3.894022107848379*^9, 3.8940221177507973`*^9}, {3.894022152988742*^9, 
   3.8940222083734083`*^9}},
 CellLabel->"In[9]:=",
 CellID->1238535565,ExpressionUUID->"b219f08e-a239-4327-a789-d1e4e9a53e98"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[Theta]", 
   RowBox[{
    RowBox[{"-", "m"}], "-", "s"}]], " ", 
  RowBox[{"(", 
   InterpretationBox[
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "s"], " ", 
       SuperscriptBox["2", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "m", "+", "s"}]], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", "m", " ", "\[Phi]"}]], " ", 
       SqrtBox[
        RowBox[{"1", "+", 
         RowBox[{"2", " ", "l"}]}]], " ", 
       SqrtBox[
        FractionBox[
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"l", "-", "m"}], ")"}], "!"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"l", "-", "s"}], ")"}], "!"}]}], 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"l", "+", "m"}], ")"}], "!"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"l", "+", "s"}], ")"}], "!"}]}]]]}], 
      RowBox[{
       SqrtBox["\[Pi]"], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "-", "m", "-", "s"}], "]"}]}]], "+", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "\[Theta]", "]"}], "2"],
      SeriesData[$CellContext`\[Theta], 0, {}, 0, 2, 1],
      Editable->False]}],
    SeriesData[$CellContext`\[Theta], 
     0, {(-1)^$CellContext`s 2^(-1 + $CellContext`m + $CellContext`s) 
      E^(Complex[0, 1] $CellContext`m $CellContext`\[Phi]) (1 + 
        2 $CellContext`l)^Rational[1, 2] 
      Pi^Rational[-1, 2] (Factorial[$CellContext`l - $CellContext`m] 
        Factorial[$CellContext`l + $CellContext`m]^(-1) 
        Factorial[$CellContext`l - $CellContext`s]/
        Factorial[$CellContext`l + $CellContext`s])^Rational[1, 2]/Gamma[
      1 - $CellContext`m - $CellContext`s]}, 0, 2, 1],
    Editable->False], ")"}]}]], "Output",
 CellChangeTimes->{3.998376012312813*^9},
 CellLabel->"Out[9]=",
 CellID->1527308680,ExpressionUUID->"337d051f-8756-4f94-bf58-cae0dbbaa58b"]
}, Open  ]],

