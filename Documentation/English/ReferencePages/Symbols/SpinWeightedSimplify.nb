Cell["Or for the l-modes:", "ExampleText",
 CellChangeTimes->{{3.997356206522826*^9, 3.9973562283694363`*^9}},
 CellID->1440772470,ExpressionUUID->"4daf3b65-5aee-40da-8c52-dcd75600dd1c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SpheroidalEquation", "[", 
   RowBox[{
   "s_", ",", "\[ScriptL]_", ",", "m_", ",", "\[Gamma]_", ",", 
    "\[CurlyTheta]_", ",", "\[CurlyPhi]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"aux", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"aux", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
          RowBox[{
          "s", ",", "\[ScriptL]", ",", "m", ",", "\[Gamma]", ",", "\[Theta]", 
           ",", "\[Phi]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Theta]", ",", "2"}], "}"}]}], "]"}], "+", 
       RowBox[{
        RowBox[{"Cot", "[", "\[Theta]", "]"}], 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
           RowBox[{
           "s", ",", "\[ScriptL]", ",", "m", ",", "\[Gamma]", ",", "\[Theta]",
             ",", "\[Phi]"}], "]"}], ",", "\[Theta]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "\[Gamma]", " ", 
           RowBox[{"(", 
            RowBox[{"m", "-", 
             RowBox[{"s", " ", 
              RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}]}], "-", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"m", "+", 
              RowBox[{"s", " ", 
               RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "^", "2"}], 
           "/", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}], "+", 
          RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
           RowBox[{"s", ",", "\[ScriptL]", ",", "m", ",", "\[Gamma]"}], "]"}],
           "+", "s", "-", 
          RowBox[{
           RowBox[{"\[Gamma]", "^", "2"}], " ", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}], ")"}], 
        RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
         RowBox[{
         "s", ",", "\[ScriptL]", ",", "m", ",", "\[Gamma]", ",", "\[Theta]", 
          ",", "\[Phi]"}], "]"}]}]}]}], ";", "\n", 
     RowBox[{"aux", "=", 
      RowBox[{"aux", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Theta]", "->", "\[CurlyTheta]"}], ",", 
         RowBox[{"\[Phi]", "->", "\[CurlyPhi]"}]}], "}"}]}]}], ";", "\n", 
     "aux"}]}], "\n", "]"}]}]], "Input",
 CellChangeTimes->{{3.997355709851468*^9, 3.997355714441595*^9}},
 CellLabel->"In[12]:=",
 CellID->795041275,ExpressionUUID->"40e32f4f-d22b-42e6-8dc4-a3815b2479d8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"SpheroidalEquation", "[", 
       RowBox[{"s", ",", 
        RowBox[{"l", "+", "1"}], ",", "m", ",", "\[Gamma]", ",", "\[Theta]", 
        ",", "\[Phi]"}], "]"}], "//", 
      RowBox[{
       RowBox[{"Series", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"\[Gamma]", ",", "0", ",", "1"}], "}"}]}], "]"}], "&"}]}], "//",
      "SpinWeightedSimplify"}], "//", "Simplify"}], "//", "Normal"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "==", "0"}], "//", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{"#", ",", 
     InterpretationBox[
      TagBox[
       TemplateBox[{"s", "l", "m", "\[Theta]", "\[Phi]"},
        "MyCustomBox",
        DisplayFunction->(StyleBox[
          FrameBox[
           RowBox[{
             SubscriptBox["", #], 
             SubscriptBox["Y", 
              RowBox[{#2, " ", #3}]], 
             RowBox[{"[", #4, ",", #5, "]"}]}], Background -> None, 
           FrameStyle -> None, RoundingRadius -> 4, 
           FrameMargins -> {{0, 1}, {0, 0}}]]& )],
       DisplayForm],
      SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]]}], "]"}], "&"}]}]}], "Input",
 CellChangeTimes->{{3.997356234122448*^9, 3.997356318871477*^9}},
 CellLabel->"In[13]:=",
 CellID->776460864,ExpressionUUID->"149ab0d5-4350-43cc-8776-787891bb7fa8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    InterpretationBox[
     FrameBox[
      RowBox[{
       SubscriptBox["", "s"], 
       SubscriptBox["Y", 
        RowBox[{"l", " \[InvisibleSpace]", "m"}]], 
       RowBox[{"[", "\[Theta]", ",", "\[Phi]", "]"}]}],
      Background->None,
      FrameMargins->{{0, 1}, {0, 0}},
      FrameStyle->None],
     SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]], "\[Rule]", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "l"}]}]], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             SqrtBox[
              RowBox[{"3", "+", 
               RowBox[{"2", " ", "l"}]}]]}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"m", " ", "s"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"2", "+", 
                 RowBox[{"3", " ", "l"}], "+", 
                 SuperscriptBox["l", "2"]}], ")"}], " ", 
               RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], " ", 
            InterpretationBox[
             FrameBox[
              RowBox[{
               SubscriptBox["", "s"], 
               SubscriptBox["Y", 
                RowBox[{
                 RowBox[{"1", "+", "l"}], " \[InvisibleSpace]", "m"}]], 
               RowBox[{"[", "\[Theta]", ",", "\[Phi]", "]"}]}],
              Background->None,
              FrameMargins->{{0, 1}, {0, 0}},
              FrameStyle->None],
             
             SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, 
              1 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]]}], "+", 
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", "l"}], ")"}], " ", 
             SqrtBox[
              RowBox[{"4", "+", 
               RowBox[{"4", " ", "l"}], "+", 
               SuperscriptBox["l", "2"], "-", 
               SuperscriptBox["m", "2"]}]], " ", 
             SqrtBox[
              RowBox[{"4", "+", 
               RowBox[{"4", " ", "l"}], "+", 
               SuperscriptBox["l", "2"], "-", 
               SuperscriptBox["s", "2"]}]], " ", 
             InterpretationBox[
              FrameBox[
               RowBox[{
                SubscriptBox["", "s"], 
                SubscriptBox["Y", 
                 RowBox[{
                  RowBox[{"2", "+", "l"}], " \[InvisibleSpace]", "m"}]], 
                RowBox[{"[", "\[Theta]", ",", "\[Phi]", "]"}]}],
               Background->None,
               FrameMargins->{{0, 1}, {0, 0}},
               FrameStyle->None],
              
              SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, 
               2 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]]}], 
            SqrtBox[
             RowBox[{"5", "+", 
              RowBox[{"2", " ", "l"}]}]]]}], ")"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "+", "l"}], ")"}], " ", 
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "l"}], "+", 
           SuperscriptBox["l", "2"], "-", 
           SuperscriptBox["m", "2"]}]], " ", 
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "l"}], "+", 
           SuperscriptBox["l", "2"], "-", 
           SuperscriptBox["s", "2"]}]]}], ")"}]}], ")"}]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.997356243827338*^9, 3.997356319188878*^9}, 
   3.99837558159321*^9, {3.9983903453720627`*^9, 3.998390349889106*^9}},
 CellLabel->"Out[14]=",
 CellID->85305860,ExpressionUUID->"2fb03638-60b4-4f03-8b70-7d749cc1fa8a"]
}, Open  ]],

