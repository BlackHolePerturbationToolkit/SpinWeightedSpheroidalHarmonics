Notebook[{

Cell[CellGroupData[{
Cell["SpinWeightedSpheroidalEigenvalue", "ObjectName",
 CellID->369169642,ExpressionUUID->"2e4c29a3-1204-4ad2-a1ae-de8dc30270e5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9a146912-e5a1-40f2-a370-ddc67999c8e5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SpinWeightedSpheroidalEigenvalue",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalEigenvalue"], "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["l", "TI"], ",", 
    StyleBox["m", "TI"], ",", 
    StyleBox["\[Gamma]", "TR"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "70e83d96-7324-4a90-8dd3-4b67156c4c1d"],
 "\[LineSeparator]gives the spin-weighted spheroidal eigenvalue with \
spheroidicity ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",ExpressionUUID->
  "ab4f1769-5916-4af5-8fa7-581a411e6a4f"],
 ", spin-weight ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "4072ab7d-bcea-4674-923d-119d1c8d95a0"],
 ", degree ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",ExpressionUUID->
  "5cc8dccf-87ea-4e2f-9e1a-cf6f894f7424"],
 " and order ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",ExpressionUUID->
  "31c870f4-05ee-4baa-85fb-b6215a89eb55"],
 "."
}], "Usage",
 CellChangeTimes->{{3.8936166755811777`*^9, 3.89361667580898*^9}},
 CellID->553916911,ExpressionUUID->"18717d32-7b15-4a70-af8e-7e9a23be9f47"],

Cell["\<\
Mathematical function, suitable for both symbolic and numerical manipulation.\
\
\>", "Notes",
 CellChangeTimes->{{3.8939367479472237`*^9, 3.893936748229895*^9}},
 CellID->807563746,ExpressionUUID->"90369b84-a87e-404d-b83d-56332a96484a"],

Cell[TextData[{
 "For real ",
 Cell[BoxData[
 "\[Gamma]"], "InlineFormula",ExpressionUUID->
  "b624de0f-c5a0-475e-8f80-5415f9d3815a"],
 ", ",
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalEigenvalue",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalEigenvalue"]], "InlineFormula",ExpressionUUID->
  "9ad38e91-8f57-42e4-acd3-97e474f84173"],
 " computes the eigenvalue, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
   SubscriptBox["\[Lambda]", "lm"]}]], "InlineFormula",ExpressionUUID->
  "e0b1a3b0-a761-4136-ab65-cddedefd357e"],
 ", for the oblate spin-weighted spheroidal equation with oblateness ",
 Cell[BoxData[
 "\[Gamma]"], "InlineFormula",ExpressionUUID->
  "84bae6d1-693a-4b9e-807b-3b2286abc382"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           RowBox[{
             FractionBox["1", 
              RowBox[{"sin", "\[Theta]"}]], 
             FractionBox[
              StyleBox["d", "TI"], 
              RowBox[{
                StyleBox["d", "TI"], "\[Theta]"}]], 
             RowBox[{"(", 
               RowBox[{"sin", "\[Theta]", 
                 FractionBox[
                  StyleBox["d", "TI"], 
                  RowBox[{
                    StyleBox["d", "TI"], "\[Theta]"}]]}], ")"}], "-", 
             SuperscriptBox["\[Gamma]", "2"], 
             SuperscriptBox["sin", "2"], "\[Theta]", "-", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["m", "TI"], "+", 
                   StyleBox["s", "TI"], "cos", "\[Theta]"}], ")"}], "2"], 
              RowBox[{
                SuperscriptBox["sin", "2"], "\[Theta]"}]], "-", "2", 
             "\[Gamma]", 
             StyleBox["s", "TI"], "cos", "\[Theta]", "+", 
             StyleBox["s", "TI"], "+", "2", 
             StyleBox["m", "TI"], "\[Gamma]", "+", 
             SubscriptBox["\[Null]", 
              StyleBox["s", "TI"]], 
             SubscriptBox["\[Lambda]", 
              RowBox[{
                StyleBox["l", "TI"], 
                StyleBox["m", "TI"]}]]}], "]"}], 
         SubscriptBox["\[Null]", 
          StyleBox["s", "TI"]], 
         SubscriptBox[
          StyleBox["S", "TI"], 
          RowBox[{
            StyleBox["l", "TI"], 
            StyleBox["m", "TI"]}]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\left[\\frac{1}{\\sin\\theta} \\frac{d}{d\\theta} \\left( \\sin\\theta \
\\frac{d}{d\\theta}\\right) - \\gamma^2 \\sin^2\\theta - \
\\frac{(m+s\\cos\\theta)^2}{\\sin^2\\theta} - 2\\gamma s \\cos\\theta + s+ 2m\
\\gamma + {}_s\\lambda_{lm} \\right] { }_{s}S_{lm} = 0", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3d7b0f0b-bf57-4277-978b-92d94f196a7b"],
 "."
}], "Notes",
 CellChangeTimes->{{3.894022960612343*^9, 3.8940229746078587`*^9}, {
  3.8944256174661427`*^9, 3.894425639163892*^9}},
 CellID->1207676429,ExpressionUUID->"47eb5375-97df-4a97-83d5-d977a12a881b"],

Cell[TextData[{
 "For imaginary ",
 Cell[BoxData[
 "\[Gamma]"], "InlineFormula",ExpressionUUID->
  "41241fa2-90ec-4096-92ce-58c231020bd1"],
 ", ",
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalEigenvalue",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalEigenvalue"]], "InlineFormula",ExpressionUUID->
  "c63fced4-ab5d-40e3-8b9a-0b07df4bc747"],
 " computes the eigenvalue for the prolate spin-weighted spheroidal \
equation."
}], "Notes",
 CellChangeTimes->{{3.894425659383003*^9, 3.894425670886726*^9}},
 CellID->1427934096,ExpressionUUID->"18e2db2b-ec0c-446e-8549-924764650036"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalEigenvalue",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalEigenvalue"]], "InlineFormula",ExpressionUUID->
  "54794c5a-7ccb-41e5-9a0c-9fe620dbaf5b"],
 " can be evaluated for arbitrary complex spheroidicity."
}], "Notes",
 CellChangeTimes->{{3.894425714376443*^9, 3.894425727147029*^9}},
 CellID->2072931994,ExpressionUUID->"e8c49ae9-e3a6-463a-9435-64ae9cafb716"],

Cell[TextData[{
 "The definition for ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
   SubscriptBox["\[Lambda]", "lm"]}]], "InlineFormula",ExpressionUUID->
  "bb998c23-96cb-4caa-a304-32b12830e3e2"],
 " is consistent with that of [",
 ButtonBox["Teukolsky, S. A., Astrophys. J. 185, 635\[Dash]647 (1973)",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://dx.doi.org/10.1086/152444"], None}],
 "] and of [",
 ButtonBox["Sasaki, M. & Tagoshi, H. Living Rev. Relativ. (2003) 6: 6",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://dx.doi.org/10.12942/lrr-2003-6"], None}],
 "]."
}], "Notes",
 CellChangeTimes->{{3.894023055837295*^9, 3.8940230747257547`*^9}, {
  3.8940231210791607`*^9, 3.894023121643183*^9}, {3.8940231552328176`*^9, 
  3.894023190488235*^9}, {3.89442568266189*^9, 3.894425689233685*^9}},
 CellID->565427179,ExpressionUUID->"a8988489-348f-4a4a-809c-4b7b4df5ea41"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{"\[Gamma]", "=", "0"}]], "InlineFormula",ExpressionUUID->
  "d859d470-351d-4fe8-b7e0-22b5157696e3"],
 ", ",
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalEigenvalue",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalEigenvalue"]], "InlineFormula",ExpressionUUID->
  "8dc972a2-d84a-441b-ba50-e8c9df31f564"],
 " reduces to ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    RowBox[{"l", 
     RowBox[{"(", 
      RowBox[{"l", "+", "1"}], ")"}]}], " ", "-", " ", 
    RowBox[{"s", 
     RowBox[{"(", 
      RowBox[{"s", "+", "1"}], ")"}]}]}], ")"}]], "InlineFormula",
  ExpressionUUID->"6be72cfb-e6fd-4ef7-b6ed-f962764fad36"],
 "."
}], "Notes",
 CellChangeTimes->{{3.894023194458664*^9, 3.8940232098277063`*^9}},
 CellID->519459478,ExpressionUUID->"080befa2-286f-4c86-ac57-9ea17f596568"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{"s", "=", "0"}]], "InlineFormula",ExpressionUUID->
  "1c9281c0-6e54-46e2-91e9-710cff9ef281"],
 ", ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["SpinWeightedSpheroidalEigenvalue",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalEigenvalue"], "[", 
   RowBox[{"0", ",", " ", 
    StyleBox["l", "TI"], ",", " ", 
    StyleBox["m", "TI"], ",", " ", 
    StyleBox["\[Gamma]", "TR"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "74a2e4aa-170e-4567-be23-2108a4d04c05"],
 " is equivalent to ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    ButtonBox["SpheroidalEigenvalue",
     BaseStyle->"Link"], "[", 
    RowBox[{
     StyleBox["l", "TI"], ",", " ", 
     StyleBox["m", "TI"], ",", " ", 
     RowBox[{
      ButtonBox["I",
       BaseStyle->"Link"], " ", 
      StyleBox["\[Gamma]", "TR"]}]}], "]"}], " ", "-", " ", 
   RowBox[{"2", " ", 
    StyleBox["m", "TI"], " ", 
    StyleBox["\[Gamma]", "TR"]}]}]], "InlineFormula",ExpressionUUID->
  "46317414-33e6-4659-9653-4e9c3c72a8e8"],
 "."
}], "Notes",
 CellChangeTimes->{{3.894023227208157*^9, 3.894023241771558*^9}},
 CellID->1034421691,ExpressionUUID->"ed27bbf2-e7c7-44dc-b6f4-4d9ba1db27d8"],

Cell[TextData[{
 "For numerical values of ",
 Cell[BoxData[
 "\[Gamma]"], "InlineFormula",ExpressionUUID->
  "f4b54ac3-32ed-4e7e-aa1d-be22d34afb86"],
 ", ",
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalEigenvalue",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalEigenvalue"]], "InlineFormula",ExpressionUUID->
  "67366cac-4927-41ca-bcf6-f74acd86384a"],
 " aims to produce a numerical value with the maximum possible precision \
given the precision of ",
 Cell[BoxData[
 "\[Gamma]"], "InlineFormula",ExpressionUUID->
  "46d3a789-ae10-464b-9796-57683b0fcecd"],
 "."
}], "Notes",
 CellChangeTimes->{{3.89402324434087*^9, 3.8940232720369887`*^9}},
 CellID->1645238172,ExpressionUUID->"4e58a4c9-2612-4239-8db4-f28de9ca9310"],

Cell[TextData[{
 "In most cases, the precision of the result will be approximately equal to \
the precision of ",
 Cell[BoxData[
 "\[Gamma]"], "InlineFormula",ExpressionUUID->
  "4df58043-cd69-4359-9e39-5d31e15dc873"],
 "."
}], "Notes",
 CellChangeTimes->{{3.894023289780765*^9, 3.8940232945615673`*^9}},
 CellID->243924298,ExpressionUUID->"c20e1d94-b701-47ce-aadc-4bce17ce2110"],

Cell["\<\
By default, numerical values are computed using an expansion based on \
spin-weighted spherical harmonics for an initial guess followed by Leaver's \
method to obtain an accurate answer.\
\>", "Notes",
 CellID->518518032,ExpressionUUID->"e14c6b72-d8c2-4a4e-abd2-876bfb8f19ff"],

Cell[TextData[{
 "Series expansions about ",
 Cell[BoxData[
  RowBox[{"\[Gamma]", "=", "0"}]], "InlineFormula",ExpressionUUID->
  "58e156ba-1f16-4a70-a582-39c3f7502170"],
 " can be computed to arbitrary order for generic ",
 Cell[BoxData[
 "s"], "InlineFormula",ExpressionUUID->"443ac712-3fa2-4f34-9442-889fe882a423"],
 ", ",
 Cell[BoxData[
 "l"], "InlineFormula",ExpressionUUID->"8292126b-8871-40de-adac-e8ced9794c65"],
 " and ",
 Cell[BoxData[
 "m"], "InlineFormula",ExpressionUUID->"4a0af911-6533-431e-a26d-b2d2c20fb8f1"],
 "."
}], "Notes",
 CellChangeTimes->{{3.894023298306334*^9, 3.894023322210184*^9}},
 CellID->89394363,ExpressionUUID->"95a58567-c8aa-42e5-ae3a-e567e317d2c1"],

Cell[TextData[{
 "Series expansions about ",
 Cell[BoxData[
  RowBox[{"\[Gamma]", " ", "=", " ", "\[Infinity]"}]], "InlineFormula",
  ExpressionUUID->"cf519908-668b-4a75-b909-6cb794ec202e"],
 " can be computed to arbitrary order for specific ",
 Cell[BoxData[
 "s"], "InlineFormula",ExpressionUUID->"b26e5b6b-bc87-458c-a717-d26fb3f6d2f6"],
 ", ",
 Cell[BoxData[
 "l"], "InlineFormula",ExpressionUUID->"fe62749e-3598-4121-b6dc-bbac4004220e"],
 " and ",
 Cell[BoxData[
 "m"], "InlineFormula",ExpressionUUID->"68de7281-e9fa-47d6-8048-89ed0947b9a2"],
 "."
}], "Notes",
 CellChangeTimes->{{3.8940233065550003`*^9, 3.894023328376443*^9}},
 CellID->1359989688,ExpressionUUID->"93c4b7e2-e786-4155-84ff-3755b23a4903"],

Cell[TextData[{
 "For Methods that support suboptions, they may be passed as a list. For \
example ",
 ButtonBox["Method",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Method"],
 " \[Rule] {\"Leaver\", \"InitialGuess\" \[Rule] 0.1} sets the \"InitialGuess\
\" suboption to have value 0.1."
}], "Notes",
 CellChangeTimes->{3.89402333735102*^9},
 CellID->1678231195,ExpressionUUID->"d405fdde-f1ae-45b9-ad4c-8a33a52d799b"],

Cell["\<\
The possible suboptions that the \"Lever\" method accepts are: \"InitialGuess\
\" \[Rule] \[Lambda] and \"NumInversions\" \[Rule] n.\
\>", "Notes",
 CellChangeTimes->{{3.894023349761568*^9, 3.894023351448554*^9}},
 CellID->981474667,ExpressionUUID->"5a39c665-2cd7-4679-9fd6-160031aff216"],

Cell["\<\
The possible suboptions that the \"SphericalExpansion\" method accepts are: \
\"NumTerms\" \[Rule] n.\
\>", "Notes",
 CellID->822835662,ExpressionUUID->"43913d62-d76a-4916-95e5-98a2b8a3d257"],

Cell["The following options can be given: ", "Notes",
 CellID->339913432,ExpressionUUID->"b20cd914-2a1b-45a5-99ae-092cc19e85b7"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "5b723d96-8f8c-4815-85d0-2f969e4a4127"], 
    ButtonBox["Method",
     BaseStyle->"Link"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[
    "Possible choices include \"Leaver\" and \"SphericalExpansion\".", 
     "TableText",ExpressionUUID->"c3f27158-30d7-4f5d-88f8-7841a17bb912"]}
  }]], "3ColumnTableMod",
 CellChangeTimes->{{3.894023367859533*^9, 3.8940233678595457`*^9}},
 CellID->618550604,ExpressionUUID->"649a2f7d-8841-4992-8414-15bb92df1760"]
}, Open  ]],

