Cell["\<\
This is turned off by default as SpeedUpSWSHSeries[True] Unprotects Series, \
which could have unintended consequences down the line. However we have not \
yet encountered any of them so far.  \
\>", "ExampleText",
 CellChangeTimes->{{3.993486694366593*^9, 3.993486786131873*^9}},
 CellID->1357999206,ExpressionUUID->"ad697df2-f66a-4e03-b9fc-1c9dc226a5ce"]
