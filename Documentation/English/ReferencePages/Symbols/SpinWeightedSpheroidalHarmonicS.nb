Cell["Evaluate using Leaver's method:", "ExampleText",
 CellChangeTimes->{{3.893917799037132*^9, 3.893917834899344*^9}, {
  3.893918114311927*^9, 3.893918114449228*^9}},
 CellID->280197593,ExpressionUUID->"95b2c82e-d3f9-4431-9848-013e7fd38b39"],

Cell[BoxData[
 RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "0.1", ",", 
   RowBox[{"Method", "->", "\"\<Leaver\>\""}]}], "]"}]], "Input",
 CellChangeTimes->{{3.893917836856348*^9, 3.8939178383111486`*^9}, {
  3.893917978531878*^9, 3.893917984390256*^9}, {3.893918079003701*^9, 
  3.893918088639641*^9}},
 CellLabel->"In[1]:=",
 CellID->1735115416,ExpressionUUID->"38db52f6-4e05-4f17-bbbb-284f5220b9d8"],

Cell["\<\
For non-zero spheroidicity, this is equivalent to the default \
Method\[Rule]Automatic:\
\>", "ExampleText",
 CellChangeTimes->{{3.893918014943392*^9, 3.893918051639867*^9}},
 CellID->10000292,ExpressionUUID->"36d877ab-ff45-43bb-8c1b-4947964e9974"],

Cell[BoxData[
 RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "0.1"}], "]"}]], "Input",
 CellChangeTimes->{{3.893917836856348*^9, 3.8939178383111486`*^9}, {
  3.893917978531878*^9, 3.893917984390256*^9}, {3.89391805269558*^9, 
  3.8939180575249248`*^9}},
 CellLabel->"In[2]:=",
 CellID->1473625781,ExpressionUUID->"222d29b4-8edd-4eef-adfc-64b75201d03d"],

Cell["\<\
Evaluate using Leaver's method with a specific number of terms in the series:\
\
\>", "ExampleText",
 CellChangeTimes->{{3.893917799037132*^9, 3.893917834899344*^9}, {
  3.893918106191593*^9, 3.8939181102077203`*^9}},
 CellID->1134642991,ExpressionUUID->"6de9a35e-bbdc-4d05-908a-aab5efad3808"],

Cell[BoxData[
 RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "0.1", ",", 
   RowBox[{"Method", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Leaver\>\"", ",", 
      RowBox[{"\"\<NumTerms\>\"", "->", "8"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->1666348173,ExpressionUUID->"3e3e35a3-0119-46a7-8da9-b28ca1ee35c8"],

Cell[TextData[{
 "Evaluate using an expansion in spin-weighted spherical harmonics with 6 \
terms in the series either side of the specified ",
 Cell[BoxData[
 "l"], "InlineFormula",ExpressionUUID->"7b6623d2-2602-4f7e-b70c-cecd711ed112"],
 " value:"
}], "ExampleText",
 CellChangeTimes->{{3.893917799037132*^9, 3.893917834899344*^9}, {
  3.8939178817874126`*^9, 3.893917901076597*^9}, {3.8939179319468718`*^9, 
  3.8939179460032067`*^9}, {3.893917998259857*^9, 3.893918001380533*^9}},
 CellID->1652622454,ExpressionUUID->"51e5e6a0-bfdb-4950-8ba6-909448cf56a9"],

Cell[BoxData[
 RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "0.1", ",", 
   RowBox[{"Method", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<SphericalExpansion\>\"", ",", 
      RowBox[{"\"\<NumTerms\>\"", "->", "6"}]}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.893917836856348*^9, 3.893917868479554*^9}, {
  3.8939179129045978`*^9, 3.89391791360913*^9}, {3.893917957577469*^9, 
  3.893917986876872*^9}},
 CellLabel->"In[4]:=",
 CellID->1424718933,ExpressionUUID->"89ff2eb9-6117-4c14-893b-cee329a7ebb0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Applications", "ExampleSection",ExpressionUUID->
   "b667bf56-cbd4-4787-b49a-9bc911a91fa6"],
  $Line = 0; Null]], "ExampleSection",
 CellID->2043278461,ExpressionUUID->"0e695195-68c8-40b4-8002-eccb1e9f59dd"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalHarmonicS",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicS"]], "InlineFormula",ExpressionUUID->
  "6625bc37-2b33-4f28-88b2-35b2726c2a20"],
 " is an eigenfunction of the spin-weighted spheroidal equation (with \
eigenvalue given by ",
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalEigenvalue",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalEigenvalue"]], "InlineFormula",ExpressionUUID->
  "168b971a-2064-4a92-a2dd-56d96f654f9c"],
 ") which arises from applying separation of variables to the Teukolsky \
equation:"
}], "ExampleText",
 CellChangeTimes->{{3.8939128590233*^9, 3.893912871045609*^9}, {
  3.893913212467408*^9, 3.893913230562805*^9}, {3.893917621013368*^9, 
  3.8939176789151897`*^9}},
 CellID->287351033,ExpressionUUID->"da6e51ba-0fef-4381-a8d8-115605bae2d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "=", 
      RowBox[{"-", "2"}]}], ",", 
     RowBox[{"l", "=", "2"}], ",", 
     RowBox[{"m", "=", "2"}], ",", 
     RowBox[{"\[Gamma]", "=", "0.1"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sSlm", "=", 
     RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
      RowBox[{"s", ",", "l", ",", "m", ",", "\[Gamma]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"s\[Lambda]lm", "=", 
     RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
      RowBox[{"s", ",", "l", ",", "m", ",", "\[Gamma]"}], "]"}]}], ";", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox["1", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]], 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Sin", "[", "\[Theta]", "]"}], 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"sSlm", "[", 
                 RowBox[{"\[Theta]", ",", "0"}], "]"}], ",", "\[Theta]"}], 
               "]"}]}], ",", "\[Theta]"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               SuperscriptBox["\[Gamma]", "2"]}], 
              SuperscriptBox[
               RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "-", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"m", "+", 
                 RowBox[{"s", " ", 
                  RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "2"], 
              SuperscriptBox[
               RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]], "-", 
             RowBox[{"2", "\[Gamma]", " ", "s", " ", 
              RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", "s", "+", 
             RowBox[{"2", "m", " ", "\[Gamma]"}]}], ")"}], 
           RowBox[{"sSlm", "[", 
            RowBox[{"\[Theta]", ",", "0"}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"-", "s\[Lambda]lm"}], " ", 
          RowBox[{"sSlm", "[", 
           RowBox[{"\[Theta]", ",", "0"}], "]"}]}]}], "}"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Automatic", ",", "Dashed"}], "}"}]}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.8939129501189413`*^9, 3.893913203565419*^9}, {
  3.893913235942719*^9, 3.893913375027428*^9}, {3.893913483128559*^9, 
  3.8939135040148153`*^9}},
 CellLabel->"In[39]:=",
 CellID->2079926345,ExpressionUUID->"cd08f847-fede-4e9a-ba6b-a15dc03b60c4"],

