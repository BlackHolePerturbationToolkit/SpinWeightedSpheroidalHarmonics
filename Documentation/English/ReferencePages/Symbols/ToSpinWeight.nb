Cell["\<\
We can use a combination of DerivativeToYslm and ToSpinWeight to implement \
the Schwarzschild \[Eth] and \[Eth]' as spin raising and lowering operators \
\>", "ExampleText",
 CellChangeTimes->{{3.990180812680575*^9, 3.990180878303454*^9}},
 CellID->89482782,ExpressionUUID->"8f644ecc-ebfc-418b-8e3c-b6245aa42c28"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Eth]", "[", 
    RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
     RowBox[{
     "s_", ",", "\[ScriptL]_", ",", "m_", ",", "\[Theta]", ",", "\[Phi]"}], 
     "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{
        SqrtBox["2"], "r"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"#", ",", "\[Theta]"}], "]"}], "+", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"Csc", "[", "\[Theta]", "]"}], 
         RowBox[{"D", "[", 
          RowBox[{"#", ",", "\[Phi]"}], "]"}]}], "-", 
        RowBox[{"s", " ", 
         RowBox[{"Cot", "[", "\[Theta]", "]"}], "#"}]}], ")"}]}], "&"}], "@", 
    
    RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
     RowBox[{
     "s", ",", "\[ScriptL]", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Eth]p", "[", 
    RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
     RowBox[{
     "s_", ",", "\[ScriptL]_", ",", "m_", ",", "\[Theta]", ",", "\[Phi]"}], 
     "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{
        SqrtBox["2"], "r"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"#", ",", "\[Theta]"}], "]"}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"Csc", "[", "\[Theta]", "]"}], 
         RowBox[{"D", "[", 
          RowBox[{"#", ",", "\[Phi]"}], "]"}]}], "+", 
        RowBox[{"s", " ", 
         RowBox[{"Cot", "[", "\[Theta]", "]"}], "#"}]}], ")"}]}], "&"}], "@", 
    
    RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
     RowBox[{
     "s", ",", "\[ScriptL]", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
     "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9901804003248034`*^9, 3.9901804073205013`*^9}, {
  3.990180456682281*^9, 3.990180572608306*^9}, {3.990180603112076*^9, 
  3.990180608035858*^9}, {3.990180641515926*^9, 3.9901807012099257`*^9}, {
  3.99018091824207*^9, 3.990180919631374*^9}, {3.990180989962078*^9, 
  3.990181031996524*^9}, {3.990181067319314*^9, 3.990181103297172*^9}, {
  3.990181141213943*^9, 3.990181191216661*^9}, {3.990181235025546*^9, 
  3.990181281661509*^9}},
 CellLabel->"In[61]:=",
 CellID->996636405,ExpressionUUID->"4b133cd9-d0b8-4a16-94c2-a637fbea4871"],

Cell[CellGroupData[{

Cell[BoxData[{
