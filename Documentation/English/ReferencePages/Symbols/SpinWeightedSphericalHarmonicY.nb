Cell[BoxData[
 RowBox[{
  FractionBox["1", "8"], " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"3", " ", "\[ImaginaryI]", " ", "\[Phi]0"}]], " ", 
  SqrtBox[
   FractionBox["33", 
    RowBox[{"2", " ", "\[Pi]"}]]], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "\[ImaginaryI]"}], ")"}], "-", 
    RowBox[{"3", " ", "\[Phi]"}], "+", 
    RowBox[{"3", " ", "\[Phi]0"}]}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "\[ImaginaryI]"}], ")"}], "-", 
    RowBox[{"3", " ", "\[Phi]"}], "+", 
    RowBox[{"3", " ", "\[Phi]0"}]}], ")"}], " ", 
  RowBox[{"Cos", "[", 
   FractionBox["\[Theta]", "2"], "]"}], " ", 
  RowBox[{"(", 
   RowBox[{"17", "+", 
    RowBox[{"24", " ", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
    RowBox[{"15", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"2", " ", "\[Theta]"}], "]"}]}]}], ")"}], " ", 
  SuperscriptBox[
   RowBox[{"Sin", "[", 
    FractionBox["\[Theta]", "2"], "]"}], "5"]}]], "Output",
