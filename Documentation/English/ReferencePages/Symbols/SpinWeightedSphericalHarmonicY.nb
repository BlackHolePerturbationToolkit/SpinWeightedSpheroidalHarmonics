Cell[TextData[{
 "The parameters are restricted such that ",
 Cell[BoxData[
  RowBox[{"l", "\[GreaterEqual]", 
   RowBox[{"\[LeftBracketingBar]", "s", "\[RightBracketingBar]"}]}]], 
  "InlineFormula",ExpressionUUID->"98314665-0063-4920-bf11-a3f42204f830"],
 ", ",
 Cell[BoxData[
  RowBox[{"l", "\[GreaterEqual]", 
   RowBox[{"\[LeftBracketingBar]", "m", "\[RightBracketingBar]"}]}]], 
  "InlineFormula",ExpressionUUID->"61c89f9b-d382-4811-81f6-09f6e6a56009"],
 ", ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"l", "-", "s"}], "\[Element]", "\[DoubleStruckCapitalZ]"}]], 
  "InlineFormula",ExpressionUUID->"b06d5406-1b43-429a-8000-ab46a5a3df9d"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"m", "-", "s"}], "\[Element]", "\[DoubleStruckCapitalZ]"}]], 
  "InlineFormula",ExpressionUUID->"56ad4bf3-b9ab-49ed-841b-1518c558c6c6"],
 ". Invalid parameters produce a warning message and return $Failed:"
}], "ExampleText",
