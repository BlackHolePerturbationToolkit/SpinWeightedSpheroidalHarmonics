  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
     SubscriptBox["S", 
      RowBox[{"l", "m"}]]}], 
    RowBox[{"(", 
     RowBox[{"\[Theta]", ",", 
      RowBox[{"\[Phi]", ";", "\[Gamma]"}]}], ")"}]}], "=", " ", 
