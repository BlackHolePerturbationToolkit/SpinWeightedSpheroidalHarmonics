Cell["\<\
In version 1.1 we added automatic evaluation of some derivatives. As this \
might break backwards compatibility, this behavior can be disabled:\
\>", "ExampleText",
 CellChangeTimes->{{3.997249898959044*^9, 3.997249923176587*^9}, {
  3.997250048332747*^9, 3.9972501113261757`*^9}},
 CellID->1367676074,ExpressionUUID->"5524c8fd-9192-4cb7-8a19-fc5c131d2f0c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Derivative", "[", 
    RowBox[{"0", ",", "0", ",", "0", ",", "1", ",", "0"}], "]"}], "[", 
   "SpinWeightedSphericalHarmonicY", "]"}], "[", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "\[Theta]", ",", "\[Phi]"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetSpinWeightedOptions", "[", 
   RowBox[{"\"\<EvaluateDerivatives\>\"", "->", "False"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Derivative", "[", 
    RowBox[{"0", ",", "0", ",", "0", ",", "1", ",", "0"}], "]"}], "[", 
   "SpinWeightedSphericalHarmonicY", "]"}], "[", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "\[Theta]", ",", "\[Phi]"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.997249877845754*^9, 3.997249895702869*^9}, {
  3.9972501147275743`*^9, 3.997250173332121*^9}},
 CellLabel->"In[1]:=",
 CellID->1586921873,ExpressionUUID->"a834104e-65a5-498b-b791-1cfa2a57a40e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Phi]"}]]}], " ", 
  SqrtBox[
   FractionBox["5", "\[Pi]"]], " ", 
  SuperscriptBox[
   RowBox[{"Cos", "[", 
    FractionBox["\[Theta]", "2"], "]"}], "3"], " ", 
  RowBox[{"Sin", "[", 
   FractionBox["\[Theta]", "2"], "]"}]}]], "Output",
 CellChangeTimes->{{3.997249886315661*^9, 3.997249896111593*^9}, {
   3.997250148118763*^9, 3.997250173737153*^9}, 3.997250529783757*^9, 
   3.9972510662182713`*^9, 3.998375471479906*^9},
 CellLabel->"Out[1]=",
 CellID->542326125,ExpressionUUID->"d4324fa1-c932-4349-9d9b-bbf5c8557f65"],

Cell[BoxData[
 InterpretationBox[
  FrameBox[
   RowBox[{
    SubscriptBox["", 
     RowBox[{"-", "2"}]], 
    SubsuperscriptBox["Y", 
     RowBox[{"2", " \[InvisibleSpace]", "2"}], 
     RowBox[{"(", "1", ",", "0", ")"}]], 
    RowBox[{"[", "\[Theta]", ",", "\[Phi]", "]"}]}],
   Background->None,
   FrameMargins->{{0, 1}, {0, 0}},
   FrameStyle->None],
  Derivative[0, 0, 0, 1, 0][
  SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY][-2, 2, 
   2, $CellContext`\[Theta], $CellContext`\[Phi]]]], "Output",
 CellChangeTimes->{{3.997249886315661*^9, 3.997249896111593*^9}, {
   3.997250148118763*^9, 3.997250173737153*^9}, 3.997250529783757*^9, 
