Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SpinWeightedSphericalHarmonicY",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSphericalHarmonicY"]], "InlineFormula",ExpressionUUID->
  "114d1763-2a89-4374-a84e-4d4097e93595"],
 " is an eigenfunction of the spin-weighted spherical equation which arises \
from applying separation of variables to the Teukolsky equation:"
}], "ExampleText",
 CellChangeTimes->{{3.8939128590233*^9, 3.893912871045609*^9}, {
  3.893913212467408*^9, 3.893913230562805*^9}, {3.893917621013368*^9, 
  3.8939176789151897`*^9}, {3.8940225435444107`*^9, 3.894022561260681*^9}},
 CellID->287351033,ExpressionUUID->"6822ae17-a84b-4524-8fb0-ac785f54f9f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "=", "2"}], ",", 
     RowBox[{"l", "=", "5"}], ",", 
     RowBox[{"m", "=", "3"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sYlm", "=", 
     RowBox[{"FunctionExpand", "[", 
      RowBox[{
       StyleBox["SpinWeightedSphericalHarmonicY",
        FontColor->GrayLevel[0]], "[", 
       RowBox[{"s", ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
       "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"\[Lambda]", "=", 
     RowBox[{
      RowBox[{"l", 
       RowBox[{"(", 
        RowBox[{"l", "+", "1"}], ")"}]}], "-", 
      RowBox[{"s", 
       RowBox[{"(", 
        RowBox[{"s", "+", "1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox["1", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]], 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], 
           RowBox[{"D", "[", 
            RowBox[{"sYlm", ",", "\[Theta]"}], "]"}]}], ",", "\[Theta]"}], 
         "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"m", "+", 
               RowBox[{"s", " ", 
                RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "2"], 
            SuperscriptBox[
             RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]]}], "+", "s"}], 
         ")"}], "sYlm"}]}], "==", 
      RowBox[{
       RowBox[{"-", "\[Lambda]"}], " ", "sYlm"}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.8939129501189413`*^9, 3.893913203565419*^9}, {
  3.893913235942719*^9, 3.893913375027428*^9}, {3.893913483128559*^9, 
  3.8939135040148153`*^9}, {3.894022590817399*^9, 3.894022671031185*^9}, {
  3.894022830149585*^9, 3.894022840192585*^9}, {3.89402287984954*^9, 
  3.894022909888946*^9}},
 CellLabel->"In[3]:=",
 CellID->2079926345,ExpressionUUID->"750b58e6-c316-4201-bc30-13285d84187e"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.998376019096747*^9},
 CellLabel->"Out[3]=",
 CellID->1053766987,ExpressionUUID->"1856fe2d-11c9-4b83-90c2-04435a0a7099"]
}, Open  ]]
