Cell["\<\
Spin-weighted spherical harmonics of spin weight 0 are automatically \
evaluated as spherical harmonics. This behavior can be disabled,\
\>", "ExampleText",
 CellChangeTimes->{{3.997251313385157*^9, 3.997251383702115*^9}, 
   3.997251550504685*^9},
 CellID->859312995,ExpressionUUID->"e62c8567-69e0-4f4f-a4f7-1a7a2b0dddc0"],

