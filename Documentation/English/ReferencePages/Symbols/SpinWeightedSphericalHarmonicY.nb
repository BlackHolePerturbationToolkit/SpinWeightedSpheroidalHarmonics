Cell[BoxData[
 TagBox[GridBox[{
    {"\[Piecewise]", GridBox[{
       {
        RowBox[{
         FractionBox["1", 
          RowBox[{"2", " ", 
           SqrtBox["\[Pi]"]}]], 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "s"], " ", 
          SqrtBox[
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "l"}]}]], " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", 
            FractionBox["\[Theta]", "2"], "]"}], 
           RowBox[{"m", "-", "s"}]], " ", 
          SqrtBox[
           FractionBox[
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"l", "-", "m"}], ")"}], "!"}], " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"l", "-", "s"}], ")"}], "!"}]}], 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"l", "+", "m"}], ")"}], "!"}], " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"l", "+", "s"}], ")"}], "!"}]}]]], " ", 
          RowBox[{"Hypergeometric2F1Regularized", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "l"}], "-", "s"}], ",", 
            RowBox[{"1", "+", "l", "-", "s"}], ",", 
            RowBox[{"1", "-", "m", "-", "s"}], ",", 
            SuperscriptBox[
             RowBox[{"Sin", "[", 
              FractionBox["\[Theta]", "2"], "]"}], "2"]}], "]"}], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", 
            FractionBox["\[Theta]", "2"], "]"}], 
           RowBox[{
            RowBox[{"-", "m"}], "-", "s"}]], " ", 
          RowBox[{
           InterpretationBox[
            TemplateBox[<|"head" -> "DifferenceRoot", "big" -> GridBox[{{
                  RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "\[ImaginaryI]"}], " ", "m", " ", 
                    RowBox[{"\[FormalY]", "[", "\[FormalN]", "]"}]}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "+", "\[FormalN]"}], ")"}], " ", 
                    RowBox[{"\[FormalY]", "[", 
                    RowBox[{"1", "+", "\[FormalN]"}], "]"}]}]}], "\[Equal]", 
                    "0"}]}, {
                  RowBox[{
                    RowBox[{"\[FormalY]", "[", "0", "]"}], "\[Equal]", 
                    SuperscriptBox["\[ExponentialE]", 
                    RowBox[{"\[ImaginaryI]", " ", "m"}]]}]}}, 
                BaseStyle -> {"HolonomicInnerGrid"}], "small" -> 
              RowBox[{"\[FormalY]", "[", 
                 RowBox[{"1", "+", "\[FormalN]"}], "]"}], "branchcuts" -> 
              "None"|>,
             "HolonomicDisplay"],
            DifferenceRoot[
             
             Function[{\[FormalY], \[FormalN]}, {
              Complex[0, -1] $CellContext`m \[FormalY][\[FormalN]] + (
                  1 + \[FormalN]) \[FormalY][1 + \[FormalN]] == 
               0, \[FormalY][0] == E^(Complex[0, 1] $CellContext`m)}]]], "[", 
           "k", "]"}]}]}], 
        RowBox[{"k", "\[GreaterEqual]", "0"}]},
       {"0", 
        TagBox["True",
         "PiecewiseDefault",
         AutoDelete->True]}
