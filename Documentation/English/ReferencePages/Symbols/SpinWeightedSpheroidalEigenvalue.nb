SpinWeightedSpheroidalEigenvalue"]], "InlineFormula",ExpressionUUID->
  "057e15ba-a809-4c45-b00d-b4d7b61f6035"],
 " satisfies the identity  ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
     SubscriptBox["\[Lambda]", 
      RowBox[{"l", "m"}]]}], 
    RowBox[{"(", "\[Gamma]", ")"}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", 
       RowBox[{"-", "s"}]], 
      SubscriptBox["\[Lambda]", 
       RowBox[{"l", "m"}]]}], 
     RowBox[{"(", "\[Gamma]", ")"}]}], "-", 
    RowBox[{"2", "s"}]}]}]],ExpressionUUID->
  "b1aa4f3e-21a4-44a8-81f9-edfa7e72c085"],
 ":"
}], "ExampleText",
