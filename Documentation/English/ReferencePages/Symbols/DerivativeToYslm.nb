  3.990181141213943*^9, 3.990181191216661*^9}, {3.990181235025546*^9, 
  3.990181281661509*^9}},
 CellLabel->"In[27]:=",
 CellID->996636405,ExpressionUUID->"2850a13f-eeb5-412e-af4c-1c9ec592417e"],

