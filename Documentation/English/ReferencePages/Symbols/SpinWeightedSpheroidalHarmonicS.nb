Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalHarmonicS",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicS"]], "InlineFormula",ExpressionUUID->
  "6625bc37-2b33-4f28-88b2-35b2726c2a20"],
 " is an eigenfunction of the spin-weighted spheroidal equation (with \
eigenvalue given by ",
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalEigenvalue",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalEigenvalue"]], "InlineFormula",ExpressionUUID->
  "168b971a-2064-4a92-a2dd-56d96f654f9c"],
 ") which arises from applying separation of variables to the Teukolsky \
equation:"
}], "ExampleText",
 CellChangeTimes->{{3.8939128590233*^9, 3.893912871045609*^9}, {
  3.893913212467408*^9, 3.893913230562805*^9}, {3.893917621013368*^9, 
  3.8939176789151897`*^9}},
 CellID->287351033,ExpressionUUID->"da6e51ba-0fef-4381-a8d8-115605bae2d1"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "=", 
      RowBox[{"-", "2"}]}], ",", 
     RowBox[{"l", "=", "2"}], ",", 
     RowBox[{"m", "=", "2"}], ",", 
     RowBox[{"\[Gamma]", "=", "0.1"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sSlm", "=", 
     RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
      RowBox[{"s", ",", "l", ",", "m", ",", "\[Gamma]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"s\[Lambda]lm", "=", 
     RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
      RowBox[{"s", ",", "l", ",", "m", ",", "\[Gamma]"}], "]"}]}], ";", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox["1", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]], 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Sin", "[", "\[Theta]", "]"}], 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"sSlm", "[", 
                 RowBox[{"\[Theta]", ",", "0"}], "]"}], ",", "\[Theta]"}], 
               "]"}]}], ",", "\[Theta]"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               SuperscriptBox["\[Gamma]", "2"]}], 
              SuperscriptBox[
               RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "-", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"m", "+", 
                 RowBox[{"s", " ", 
                  RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "2"], 
              SuperscriptBox[
               RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]], "-", 
             RowBox[{"2", "\[Gamma]", " ", "s", " ", 
              RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", "s", "+", 
             RowBox[{"2", "m", " ", "\[Gamma]"}]}], ")"}], 
           RowBox[{"sSlm", "[", 
            RowBox[{"\[Theta]", ",", "0"}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"-", "s\[Lambda]lm"}], " ", 
          RowBox[{"sSlm", "[", 
           RowBox[{"\[Theta]", ",", "0"}], "]"}]}]}], "}"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Automatic", ",", "Dashed"}], "}"}]}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.8939129501189413`*^9, 3.893913203565419*^9}, {
  3.893913235942719*^9, 3.893913375027428*^9}, {3.893913483128559*^9, 
  3.8939135040148153`*^9}},
 CellLabel->"In[1]:=",
 CellID->2079926345,ExpressionUUID->"cd08f847-fede-4e9a-ba6b-a15dc03b60c4"]
}, Open  ]],

