Cell[BoxData[
 InterpretationBox[
  RowBox[{
   InterpretationBox[
    TagBox[
     TemplateBox[{"s", "l", "m", "\[Theta]", "\[Phi]"},
      "MyCustomBox",
      DisplayFunction->(StyleBox[
        FrameBox[
         RowBox[{
           SubscriptBox["", #], 
           SubscriptBox["Y", 
            RowBox[{#2, " ", #3}]], 
           RowBox[{"[", #4, ",", #5, "]"}]}], Background -> None, FrameStyle -> 
         None, RoundingRadius -> 4, FrameMargins -> {{0, 1}, {0, 0}}]]& )],
     DisplayForm],
    SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        SqrtBox[
         RowBox[{
          SuperscriptBox["l", "2"], "-", 
          SuperscriptBox["m", "2"]}]], " ", "s", " ", 
        SqrtBox[
         RowBox[{
          SuperscriptBox["l", "2"], "-", 
          SuperscriptBox["s", "2"]}]], " ", 
        InterpretationBox[
         TagBox[
          TemplateBox[{"s", 
            RowBox[{
              RowBox[{"-", "1"}], "+", "l"}], "m", "\[Theta]", "\[Phi]"},
           "MyCustomBox",
           DisplayFunction->(StyleBox[
             FrameBox[
              RowBox[{
                SubscriptBox["", #], 
                SubscriptBox["Y", 
                 RowBox[{#2, " ", #3}]], 
                RowBox[{"[", #4, ",", #5, "]"}]}], Background -> None, 
              FrameStyle -> None, RoundingRadius -> 4, 
              FrameMargins -> {{0, 1}, {0, 0}}]]& )],
          DisplayForm],
         SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, -1 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]]}], 
       RowBox[{
        SuperscriptBox["l", "2"], " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"2", " ", "l"}]}]], " ", 
        SqrtBox[
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "l"}]}]]}]], "-", 
      FractionBox[
       RowBox[{
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", "l"}], ")"}], "2"], "-", 
          SuperscriptBox["m", "2"]}]], " ", "s", " ", 
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", "l"}], ")"}], "2"], "-", 
          SuperscriptBox["s", "2"]}]], " ", 
        InterpretationBox[
         TagBox[
          TemplateBox[{"s", 
            RowBox[{"1", "+", "l"}], "m", "\[Theta]", "\[Phi]"},
           "MyCustomBox",
           DisplayFunction->(StyleBox[
             FrameBox[
              RowBox[{
                SubscriptBox["", #], 
                SubscriptBox["Y", 
                 RowBox[{#2, " ", #3}]], 
                RowBox[{"[", #4, ",", #5, "]"}]}], Background -> None, 
              FrameStyle -> None, RoundingRadius -> 4, 
              FrameMargins -> {{0, 1}, {0, 0}}]]& )],
          DisplayForm],
         SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, 
          1 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]]}], 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "l"}], ")"}], "2"], " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "l"}], ")"}]}]}]], " ", 
        SqrtBox[
         RowBox[{"1", "+", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "l"}], ")"}]}]}]]}]]}], ")"}], " ", 
    "\[Gamma]"}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Gamma]", "]"}], "2"],
    SeriesData[$CellContext`\[Gamma], 0, {}, 0, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Gamma], 0, {
    SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]], $CellContext`l^(-2) (-1 + 2 $CellContext`l)^
      Rational[-1, 2] (1 + 2 $CellContext`l)^
      Rational[-1, 2] ($CellContext`l^2 - $CellContext`m^2)^
      Rational[1, 2] $CellContext`s ($CellContext`l^2 - $CellContext`s^2)^
      Rational[1, 2] 
     SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, -1 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]] - (1 + $CellContext`l)^(-2) (-1 + 
      2 (1 + $CellContext`l))^Rational[-1, 2] (1 + 2 (1 + $CellContext`l))^
     Rational[-1, 2] ((1 + $CellContext`l)^2 - $CellContext`m^2)^
     Rational[1, 
       2] $CellContext`s ((1 + $CellContext`l)^2 - $CellContext`s^2)^
     Rational[1, 2] 
    SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, 
      1 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]}, 0, 2, 1],
  Editable->False]], "Output",
