  SeriesData[$CellContext`\[Theta], 0, {
   Rational[-7, 16] 
    E^(Complex[0, 3] $CellContext`\[Phi]) (Rational[33, 2]/Pi)^Rational[1, 2],
     0, Rational[91, 64] 
    E^(Complex[0, 3] $CellContext`\[Phi]) (Rational[11, 6]/Pi)^
