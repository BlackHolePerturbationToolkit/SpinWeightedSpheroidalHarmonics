    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"l", "+", "s"}]], 
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
     SubscriptBox[
      OverscriptBox["S", "_"], 
      RowBox[{"l", "-", "m"}]]}], 
    RowBox[{"(", 
