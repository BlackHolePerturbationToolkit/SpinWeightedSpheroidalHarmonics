Cell[BoxData[{
 RowBox[{
  RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
   RowBox[{
    RowBox[{"s", "+", "1"}], ",", "l", ",", "m", ",", "\[Theta]", ",", 
    "\[Phi]"}], "]"}], "//", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{"#", ",", "\[Theta]"}], "]"}], "&"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", ">", "0"}], "}"}], ",", 
    RowBox[{"%", "//", "SpinWeightedSimplify"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", "<", "0"}], "}"}], ",", 
    RowBox[{"%%", "//", "SpinWeightedSimplify"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"%", "==", "%%"}], "//", "Simplify"}], "//", 
  RowBox[{
   RowBox[{"Solve", "[", 
