    SubscriptBox["S", 
     RowBox[{"l", "m"}]]}], 
   RowBox[{"(", 
    RowBox[{"\[Theta]", ",", "\[Phi]", ";", "\[Gamma]"}], ")"}]}]],
  ExpressionUUID->"0f885ca4-1e17-4e28-83ad-580a41110877"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a610119f-d073-48fb-9b33-e7df6fdbfe89"],
