 CellChangeTimes->{{3.893820021442511*^9, 3.893820029297389*^9}},
 CellID->743306294,ExpressionUUID->"1a800235-1d52-4e6f-a680-6f9e0ee0c894"],

Cell[TextData[{
 Cell[BoxData[
