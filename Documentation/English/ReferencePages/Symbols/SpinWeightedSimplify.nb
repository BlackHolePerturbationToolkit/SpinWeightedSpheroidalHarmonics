      DisplayForm],
     SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]], "\[Rule]", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "l"}]}]], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             SqrtBox[
              RowBox[{"3", "+", 
               RowBox[{"2", " ", "l"}]}]]}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"m", " ", "s"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"2", "+", 
                 RowBox[{"3", " ", "l"}], "+", 
                 SuperscriptBox["l", "2"]}], ")"}], " ", 
               RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], " ", 
            InterpretationBox[
             TagBox[
              TemplateBox[{"s", 
                RowBox[{"1", "+", "l"}], "m", "\[Theta]", "\[Phi]"},
               "MyCustomBox",
               DisplayFunction->(StyleBox[
                 FrameBox[
                  RowBox[{
                    SubscriptBox["", #], 
                    SubscriptBox["Y", 
                    RowBox[{#2, " ", #3}]], 
                    RowBox[{"[", #4, ",", #5, "]"}]}], Background -> None, 
                  FrameStyle -> None, RoundingRadius -> 4, 
                  FrameMargins -> {{0, 1}, {0, 0}}]]& )],
              DisplayForm],
             
             SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, 
              1 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]]}], "+", 
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", "l"}], ")"}], " ", 
             SqrtBox[
              RowBox[{"4", "+", 
               RowBox[{"4", " ", "l"}], "+", 
               SuperscriptBox["l", "2"], "-", 
               SuperscriptBox["m", "2"]}]], " ", 
             SqrtBox[
              RowBox[{"4", "+", 
               RowBox[{"4", " ", "l"}], "+", 
               SuperscriptBox["l", "2"], "-", 
               SuperscriptBox["s", "2"]}]], " ", 
             InterpretationBox[
              TagBox[
               TemplateBox[{"s", 
                 RowBox[{"2", "+", "l"}], "m", "\[Theta]", "\[Phi]"},
                "MyCustomBox",
                DisplayFunction->(StyleBox[
                  FrameBox[
                   RowBox[{
                    SubscriptBox["", #], 
                    SubscriptBox["Y", 
                    RowBox[{#2, " ", #3}]], 
                    RowBox[{"[", #4, ",", #5, "]"}]}], Background -> None, 
                   FrameStyle -> None, RoundingRadius -> 4, 
                   FrameMargins -> {{0, 1}, {0, 0}}]]& )],
               DisplayForm],
              
              SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, 
               2 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]]}], 
            SqrtBox[
             RowBox[{"5", "+", 
              RowBox[{"2", " ", "l"}]}]]]}], ")"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "+", "l"}], ")"}], " ", 
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "l"}], "+", 
           SuperscriptBox["l", "2"], "-", 
           SuperscriptBox["m", "2"]}]], " ", 
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "l"}], "+", 
           SuperscriptBox["l", "2"], "-", 
           SuperscriptBox["s", "2"]}]]}], ")"}]}], ")"}]}]}], "}"}], 
  "}"}]], "Output",
