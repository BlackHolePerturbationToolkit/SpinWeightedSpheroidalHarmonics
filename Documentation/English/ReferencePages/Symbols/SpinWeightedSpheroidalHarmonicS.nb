  FractionBox["1", 
   RowBox[{"2", " ", 
    SqrtBox["\[Pi]"]}]], 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], "s"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[ImaginaryI]", " ", "m", " ", "\[Phi]"}]], " ", 
   SqrtBox[
    RowBox[{"1", "+", 
     RowBox[{"2", " ", "l"}]}]], " ", 
   SuperscriptBox[
    RowBox[{"Cos", "[", 
     FractionBox["\[Theta]", "2"], "]"}], 
    RowBox[{"m", "-", "s"}]], " ", 
   SqrtBox[
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"l", "-", "m"}], ")"}], "!"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"l", "-", "s"}], ")"}], "!"}]}], 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"l", "+", "m"}], ")"}], "!"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"l", "+", "s"}], ")"}], "!"}]}]]], " ", 
   RowBox[{"Hypergeometric2F1Regularized", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "l"}], "-", "s"}], ",", 
     RowBox[{"1", "+", "l", "-", "s"}], ",", 
     RowBox[{"1", "-", "m", "-", "s"}], ",", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}]}]}], "]"}], " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", 
     FractionBox["\[Theta]", "2"], "]"}], 
    RowBox[{
     RowBox[{"-", "m"}], "-", "s"}]]}]}]], "Output",
 CellChangeTimes->{3.99837656929208*^9},
