 ":"
}], "ExampleText",
 CellChangeTimes->{{3.893997546888976*^9, 3.893997547442955*^9}, {
  3.893997599092846*^9, 3.893997621843812*^9}},
 CellID->664029535,ExpressionUUID->"d9d5308d-fdfa-4800-b282-e5dce0761db8"],

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "=", 
      RowBox[{"-", "1"}]}], ",", 
     RowBox[{"l", "=", "1"}], ",", 
     RowBox[{"m", "=", "1"}], ",", 
     RowBox[{"\[Gamma]", "=", "0.1"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"\[ScriptCapitalL]\[Dagger]", "[", "0", "]"}], "@", 
       RowBox[{
        RowBox[{"\[ScriptCapitalL]\[Dagger]", "[", "1", "]"}], "@", 
        RowBox[{
         RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
          RowBox[{"s", ",", "l", ",", "m", ",", "\[Gamma]"}], "]"}], "[", 
         RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}]}]}], "]"}], "==", 
     RowBox[{
      RowBox[{"Dls1", "[", 
       RowBox[{"l", ",", "m", ",", "\[Gamma]"}], "]"}], 
      RowBox[{
       RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
        RowBox[{
         RowBox[{"-", "s"}], ",", "l", ",", "m", ",", "\[Gamma]"}], "]"}], 
