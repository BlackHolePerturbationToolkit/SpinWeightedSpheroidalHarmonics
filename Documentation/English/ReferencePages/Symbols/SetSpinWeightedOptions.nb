Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinWeightedOptions", "[", 
   RowBox[{"\"\<EvaluateSpinZero\>\"", "->", "True"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
  RowBox[{"0", ",", "2", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetSpinWeightedOptions", "[", 
