Cell["The following options can be given: ", "Notes",
 CellID->1623988162,ExpressionUUID->"42cfeaf4-cf04-4c66-8969-cb9f4e8cc41b"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "89aa72ea-6820-4353-925d-ce4a287de94d"], 
    ButtonBox["Method",
     BaseStyle->"Link"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], 
    RowBox[{
    "Possible", " ", "choices", " ", "include", " ", "\"\<Leaver\>\"", " ", 
     "and", " ", 
     RowBox[{"\"\<SphericalExpansion\>\"", "."}]}]}
  }]], "3ColumnTableMod",
 CellChangeTimes->{{3.893784241738545*^9, 3.893784269636342*^9}, {
  3.893784313812704*^9, 3.893784319975196*^9}, {3.894003606247971*^9, 
