Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"s", "=", 
       RowBox[{"-", "1"}]}], ",", 
      RowBox[{"l", "=", "2"}], ",", 
