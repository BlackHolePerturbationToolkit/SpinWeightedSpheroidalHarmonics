Notebook[{

Cell[CellGroupData[{
Cell["SpinWeightedSphericalHarmonicY", "ObjectName",
 CellID->12239074,ExpressionUUID->"811e9ba4-4e0a-47f1-863e-59095f5c162b"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["SpinWeightedSphericalHarmonicY",
    BaseStyle->"Link",
    ButtonData->
     "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSphericalHarmonicY"], "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["l", "TI"], ",", " ", 
    StyleBox["m", "TI"], ",", " ", 
    StyleBox["\[Theta]", "TR"], ",", " ", 
    StyleBox["\[Phi]", "TR"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ec272d72-a081-4d90-aa97-db509cefcdec"],
 " gives the spin-weighted spherical harmonic of spin-weight ",
 Cell[BoxData[
  StyleBox[
   StyleBox["s", "TI"],
   FontSlant->"Italic"]], "InlineFormula",ExpressionUUID->
  "4bd5993c-8104-4b2b-abba-bf11ef63bfe8"],
 ", degree ",
 Cell[BoxData[
  StyleBox[
   StyleBox["l", "TI"],
   FontSlant->"Italic"]], "InlineFormula",ExpressionUUID->
  "445fb120-f2cc-4507-94a0-7ccfca565170"],
 " and order ",
 Cell[BoxData[
  StyleBox[
   StyleBox["m", "TI"],
   FontSlant->"Italic"]], "InlineFormula",ExpressionUUID->
  "bd9f5e37-029b-4584-844d-c9fbc2be7cac"],
 "."
}], "Usage",
 CellChangeTimes->{{3.893751831028497*^9, 3.8937518865717797`*^9}, {
  3.893752017072474*^9, 3.893752027199125*^9}, {3.893752059704008*^9, 
  3.893752102411684*^9}},
 CellID->1691170253,ExpressionUUID->"ab57f10f-d3c3-42a9-82b4-7efd57235e22"],

Cell[TextData[{
 ButtonBox["SpinWeightedSphericalHarmonicY",
  BaseStyle->"Link",
  ButtonData->
   "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSphericalHarmonicY"],
 " satisfies the spin-weighted spherical equation, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           RowBox[{
             FractionBox["1", 
              RowBox[{"sin", "\[Theta]"}]], 
             FractionBox[
              StyleBox["d", "TI"], 
              RowBox[{
                StyleBox["d", "TI"], "\[Theta]"}]], 
             RowBox[{"(", 
               RowBox[{"sin", "\[Theta]", 
                 FractionBox[
                  StyleBox["d", "TI"], 
                  RowBox[{
                    StyleBox["d", "TI"], "\[Theta]"}]]}], ")"}], "-", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["m", "TI"], "+", 
                   StyleBox["s", "TI"], "cos", "\[Theta]"}], ")"}], "2"], 
              RowBox[{
                SuperscriptBox["sin", "2"], "\[Theta]"}]], "+", 
             StyleBox["s", "TI"], "+", "\[Lambda]"}], "]"}], 
         SubscriptBox["\[Null]", 
          StyleBox["s", "TI"]], 
         SubscriptBox[
          StyleBox["Y", "TI"], 
          RowBox[{
            StyleBox["l", "TI"], 
            StyleBox["m", "TI"]}]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\left[\\frac{1}{\\sin\\theta} \\frac{d}{d\\theta} \\left( \\sin\\theta \
\\frac{d}{d\\theta}\\right) - \\frac{(m+s\\cos\\theta)^2}{\\sin^2\\theta} + \
s+\\lambda\\right] { }_{s}Y_{lm} = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e5f361ba-8e44-4e5f-b7a0-0358a6fdec69"]
}], "Notes",
 CellChangeTimes->{{3.893956432317297*^9, 3.89395651540025*^9}, 
   3.893956596460028*^9},
 CellID->601332013,ExpressionUUID->"e7ca9140-8bf7-4929-9f02-2e2ab8f85368"],

Cell[TextData[{
 "The eigenvalue, ",
 Cell[BoxData[
 "\[Lambda]"], "InlineFormula",ExpressionUUID->
  "c1821768-ed1b-4a40-82c9-68fd87be4a8b"],
 " for the spin-weighted spherical equation is given by ",
 Cell[BoxData[
  RowBox[{"\[Lambda]", " ", "=", " ", 
   RowBox[{
    RowBox[{"l", 
     RowBox[{"(", 
      RowBox[{"l", "+", "1"}], ")"}]}], " ", "-", " ", 
    RowBox[{"s", 
     RowBox[{"(", 
      RowBox[{"s", "+", "1"}], ")"}]}]}]}]], "InlineFormula",ExpressionUUID->
  "afe874c1-b94f-42a9-b2ee-ab1d273d55bb"],
 "."
}], "Notes",
 CellChangeTimes->{{3.893956479798276*^9, 3.8939564828415213`*^9}, {
  3.8939565205178013`*^9, 3.893956521245001*^9}},
 CellID->529099709,ExpressionUUID->"f95039eb-7462-440a-8e9b-4aa2761a0568"],

Cell[TextData[{
 ButtonBox["SpinWeightedSphericalHarmonicY",
  BaseStyle->"Link",
  ButtonData->
   "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSphericalHarmonicY"],
 " is unit-normalised on the two-sphere, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Integral]", "0", 
          RowBox[{"2", "\[Pi]"}]], 
         SubsuperscriptBox["\[Integral]", "0", "\[Pi]"], 
         SubscriptBox["\[Null]", 
          StyleBox["s", "TI"]], 
         SubscriptBox[
          StyleBox["Y", "TI"], 
          RowBox[{
            StyleBox["l", "TI"], 
            StyleBox["m", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], 
         SubscriptBox["\[Null]", 
          StyleBox["s", "TI"]], 
         SubscriptBox[
          OverscriptBox[
           StyleBox["Y", "TI"], "_"], 
          RowBox[{
            SuperscriptBox[
             StyleBox["l", "TI"], "\[Prime]"], 
            SuperscriptBox[
             StyleBox["m", "TI"], "\[Prime]"]}]], 
         RowBox[{"(", 
           RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], "sin", "\[Theta]", 
         "\[DifferentialD]", "\[Theta]", "\[DifferentialD]", "\[Phi]", 
         "\[LongEqual]", 
         SubscriptBox["\[Delta]", 
          RowBox[{
            StyleBox["l", "TI"], 
            SuperscriptBox[
             StyleBox["l", "TI"], "\[Prime]"]}]], 
         SubscriptBox["\[Delta]", 
          RowBox[{
            StyleBox["m", "TI"], 
            SuperscriptBox[
             StyleBox["m", "TI"], "\[Prime]"]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\int_0^{2\\pi} \\int_0^\\pi {}_s Y_{l m}(\\theta, \\phi) {}_s {\\bar \
Y}_{l'm'}(\\theta, \\phi) \\sin \\theta\\, d\\theta \\, d\\phi = \\delta_{l \
l'} \\delta_{m m'}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d1ddccbf-7f93-4cd4-a2d3-07ca52e6ae38"],
 "."
}], "Notes",
 CellChangeTimes->{
  3.89361714880262*^9, {3.893783162298841*^9, 3.893783162313369*^9}, {
   3.893783617003617*^9, 3.893783662623815*^9}, {3.893783967752336*^9, 
   3.893783982966914*^9}, 3.893956546847205*^9, {3.893956579888743*^9, 
   3.893956591997997*^9}, 3.89784537259079*^9},
 CellID->684176084,ExpressionUUID->"580e9b1a-2b06-4cb3-9a03-66806cf6dfe3"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{"s", "=", "0"}]], "InlineFormula",ExpressionUUID->
  "56eb3e99-b008-46f7-8da5-f8822bdf9916"],
 ", ",
 ButtonBox["SpinWeightedSphericalHarmonicY",
  BaseStyle->"Link",
  ButtonData->
   "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSphericalHarmonicY"],
 " is equivalent to ",
 ButtonBox["SphericalHarmonicY",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SphericalHarmonicY"],
 "."
}], "Notes",
 CellChangeTimes->{{3.89395649094726*^9, 3.893956493676568*^9}, {
  3.893956586320947*^9, 3.893956588752812*^9}},
 CellID->1996510583,ExpressionUUID->"b2b678b6-0991-4e94-b5b5-fa4954ab086f"],

Cell[TextData[{
 "For certain special arguments, ",
 ButtonBox["SpinWeightedSphericalHarmonicY",
  BaseStyle->"Link",
  ButtonData->
   "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSphericalHarmonicY"],
 "  automatically evaluates to exact values."
}], "Notes",
 CellChangeTimes->{{3.893820057482781*^9, 3.8938200851994257`*^9}, {
  3.893956632835705*^9, 3.893956641929296*^9}},
 CellID->1090142532,ExpressionUUID->"2e4b8160-7357-4d7f-8559-0ab5083782e3"],

Cell[TextData[{
 ButtonBox["SpinWeightedSphericalHarmonicY",
  BaseStyle->"Link",
  ButtonData->
   "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSphericalHarmonicY"],
 " can be evaluated to arbitrary numerical precision."
}], "Notes",
 CellChangeTimes->{{3.893820021442511*^9, 3.893820029297389*^9}, {
  3.893956655059482*^9, 3.893956657226897*^9}},
 CellID->743306294,ExpressionUUID->"3a756e05-fc2c-48d9-b35f-05e01c8daa27"],

Cell[TextData[{
 ButtonBox["SpinWeightedSphericalHarmonicY",
  BaseStyle->"Link",
  ButtonData->
   "paclet:SpinWeightedSpheroidalHarmonics/ref/\
