 CellID->830238903,ExpressionUUID->"f22e2e36-18ce-490f-835f-c07ed8b34b14"],

Cell["\<\
Mathematical function, suitable for both symbolic and numerical manipulation.\
\
\>", "Notes",
 CellChangeTimes->{{3.8939367479472237`*^9, 3.893936748229895*^9}},
 CellID->807563746,ExpressionUUID->"ea4bb61f-322b-4ec6-b382-2f87469fd5ec"],

Cell[TextData[{
 "For real ",
 Cell[BoxData[
 "\[Gamma]"], "InlineFormula",ExpressionUUID->
  "27b94c2e-b736-42c5-bceb-5008ff30d299"],
 ", ",
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalHarmonicS",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicS"]], "InlineFormula",ExpressionUUID->
  "d8b5dd1b-0bb2-4961-b58f-7b3ce9df0ff3"],
 " computes the oblate spin-weighted spheroidal harmonic with oblateness ",
 Cell[BoxData[
 "\[Gamma]"], "InlineFormula",ExpressionUUID->
  "068e45b9-56de-47c1-a62a-a5f8d026c548"],
 "."
}], "Notes",
 CellChangeTimes->{{3.893617093133208*^9, 3.893617096419465*^9}, 
   3.893783990989408*^9, {3.8938201345502443`*^9, 3.8938201379958873`*^9}},
 CellID->1745259945,ExpressionUUID->"994d995f-eb28-4bfc-ab35-0165cee680a4"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalHarmonicS",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicS"]], "InlineFormula",ExpressionUUID->
  "29b98934-8907-4b5c-8cf3-099937827060"],
 " satisfies the spin-weighted spheroidal equation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           RowBox[{
             FractionBox["1", 
              RowBox[{"sin", "\[Theta]"}]], 
             FractionBox[
              StyleBox["d", "TI"], 
              RowBox[{
                StyleBox["d", "TI"], "\[Theta]"}]], 
             RowBox[{"(", 
               RowBox[{"sin", "\[Theta]", 
                 FractionBox[
                  StyleBox["d", "TI"], 
                  RowBox[{
                    StyleBox["d", "TI"], "\[Theta]"}]]}], ")"}], "-", 
             SuperscriptBox["\[Gamma]", "2"], 
             SuperscriptBox["sin", "2"], "\[Theta]", "-", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["m", "TI"], "+", 
                   StyleBox["s", "TI"], "cos", "\[Theta]"}], ")"}], "2"], 
              RowBox[{
                SuperscriptBox["sin", "2"], "\[Theta]"}]], "-", "2", 
             "\[Gamma]", 
             StyleBox["s", "TI"], "cos", "\[Theta]", "+", 
             StyleBox["s", "TI"], "+", "2", 
             StyleBox["m", "TI"], "\[Gamma]", "+", 
             SubscriptBox["\[Null]", 
              StyleBox["s", "TI"]], 
             SubscriptBox["\[Lambda]", 
              RowBox[{
                StyleBox["l", "TI"], 
                StyleBox["m", "TI"]}]]}], "]"}], 
         SubscriptBox["\[Null]", 
          StyleBox["s", "TI"]], 
         SubscriptBox[
          StyleBox["S", "TI"], 
          RowBox[{
            StyleBox["l", "TI"], 
            StyleBox["m", "TI"]}]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\left[\\frac{1}{\\sin\\theta} \\frac{d}{d\\theta} \\left( \\sin\\theta \
\\frac{d}{d\\theta}\\right) - \\gamma^2 \\sin^2\\theta - \
\\frac{(m+s\\cos\\theta)^2}{\\sin^2\\theta} - 2\\gamma s \\cos\\theta + s+ 2m\
\\gamma + {}_s\\lambda_{lm} \\right] { }_{s}S_{lm} = 0", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8e2a303-372c-41fa-a777-81876c028901"],
 "."
}], "Notes",
 CellChangeTimes->{{3.893617112605961*^9, 3.8936171249631577`*^9}, {
   3.893751184166125*^9, 3.893751184441874*^9}, {3.893782931040435*^9, 
   3.893782941554207*^9}, {3.893783079713152*^9, 3.893783106599479*^9}, 
   3.893783986275863*^9},
 CellID->864508098,ExpressionUUID->"84c8760c-6bf0-4816-a61c-5de661099aba"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalHarmonicS",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicS"]], "InlineFormula",ExpressionUUID->
  "fda574bb-bed8-4ed0-937b-b40d9d9ac560"],
 " is unit-normalised on the two-sphere, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Integral]", "0", 
          RowBox[{"2", "\[Pi]"}]], 
         SubsuperscriptBox["\[Integral]", "0", "\[Pi]"], 
         SubscriptBox["\[Null]", 
          StyleBox["s", "TI"]], 
         SubscriptBox[
          StyleBox["S", "TI"], 
          RowBox[{
            StyleBox["l", "TI"], 
            StyleBox["m", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], 
         SubscriptBox["\[Null]", 
          StyleBox["s", "TI"]], 
         SubscriptBox[
          OverscriptBox[
           StyleBox["S", "TI"], "_"], 
          RowBox[{
            SuperscriptBox[
             StyleBox["l", "TI"], "\[Prime]"], 
            SuperscriptBox[
             StyleBox["m", "TI"], "\[Prime]"]}]], 
         RowBox[{"(", 
           RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], "sin", "\[Theta]", 
         "\[DifferentialD]", "\[Theta]", "\[DifferentialD]", "\[Phi]", 
         "\[LongEqual]", 
         SubscriptBox["\[Delta]", 
          RowBox[{
            StyleBox["l", "TI"], 
            SuperscriptBox[
             StyleBox["l", "TI"], "\[Prime]"]}]], 
         SubscriptBox["\[Delta]", 
          RowBox[{
            StyleBox["m", "TI"], 
            SuperscriptBox[
             StyleBox["m", "TI"], "\[Prime]"]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\int_0^{2\\pi} \\int_0^\\pi {}_s S_{l m}(\\theta, \\phi) {}_s {\\bar \
S}_{l'm'}(\\theta, \\phi) \\sin \\theta \\, d\\theta \\, d\\phi = \\delta_{l \
l'} \\delta_{m m'}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c4ea7d5f-f5d3-4253-8369-9ec754645a9e"],
 ". This is consistent with the Meixner-Sch\[ADoubleDot]fke convention for \
the spheroidal Legendre functions in the same sense that the normalisation of \
",
 ButtonBox["SphericalHarmonicY",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SphericalHarmonicY"],
 " is consistent with the Legendre functions."
}], "Notes",
 CellChangeTimes->{
  3.89361714880262*^9, {3.893783162298841*^9, 3.893783162313369*^9}, {
   3.893783617003617*^9, 3.893783662623815*^9}, {3.893783967752336*^9, 
   3.893783982966914*^9}, 3.897845336226082*^9},
 CellID->684176084,ExpressionUUID->"282e6db2-dd5a-49de-880d-3f6e1d3c95da"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{"\[Gamma]", "=", "0"}]], "InlineFormula",ExpressionUUID->
  "ba2e4f27-cb48-4efb-b75b-59a9855c92e0"],
