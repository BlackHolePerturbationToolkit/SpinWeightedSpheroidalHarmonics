Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"-", 
    RowBox[{
     FractionBox["7", "16"], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"3", " ", "\[ImaginaryI]", " ", "\[Phi]"}]], " ", 
       SqrtBox[
        FractionBox["33", 
         RowBox[{"2", " ", "\[Pi]"}]]]}], ")"}], " ", 
     SuperscriptBox["\[Theta]", "5"]}]}], "+", 
   RowBox[{
    FractionBox["91", "64"], " ", 
