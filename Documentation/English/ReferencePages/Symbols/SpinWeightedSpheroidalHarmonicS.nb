 RowBox[{
  RowBox[{
   RowBox[{"EchoTiming", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Gamma]", " ", 
       RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
        RowBox[{
        "s", ",", "l", ",", "m", ",", "\[Gamma]", ",", "\[Theta]", ",", 
         "\[Phi]"}], "]"}]}], "//", 
      RowBox[{
       RowBox[{"Series", "[", 
