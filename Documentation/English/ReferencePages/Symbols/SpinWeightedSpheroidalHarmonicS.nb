Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalHarmonicS",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicS"]], "InlineFormula",ExpressionUUID->
  "c9180227-0eef-4605-845f-114d344cab31"],
 " satisfies the identity  ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
     SubscriptBox["S", 
      RowBox[{"l", "m"}]]}], 
    RowBox[{"(", 
     RowBox[{"\[Theta]", ",", 
      RowBox[{"\[Phi]", ";", "\[Gamma]"}]}], ")"}]}], "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"l", "+", "m"}]], 
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", 
      RowBox[{"-", "s"}]], 
     SubscriptBox["S", 
      RowBox[{"l", "m"}]]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Pi]", "-", "\[Theta]"}], ",", 
      RowBox[{"\[Phi]", ";", "\[Gamma]"}]}], ")"}]}]}]],ExpressionUUID->
  "27a42116-a45c-4917-9de3-32b7bb473d09"],
 ":"
}], "ExampleText",
 CellChangeTimes->{{3.893911818021254*^9, 3.8939118695704*^9}, 
   3.893997522874208*^9, 3.893998541710747*^9},
 CellID->78990157,ExpressionUUID->"9be7fa40-f509-40cf-af6e-16182514c6ab"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "=", "2"}], ",", 
     RowBox[{"l", "=", "3"}], ",", 
     RowBox[{"m", "=", "2"}], ",", 
     RowBox[{"\[Gamma]", "=", "0.1"}], ",", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"\[Pi]", "/", "4"}]}], ",", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"\[Pi]", "/", "7"}]}]}], "}"}], ",", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{
      RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
       RowBox[{"s", ",", "l", ",", "m", ",", "\[Gamma]"}], "]"}], "[", 
      RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"l", "+", "m"}]], 
       RowBox[{
        RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
         RowBox[{
          RowBox[{"-", "s"}], ",", "l", ",", "m", ",", "\[Gamma]"}], "]"}], 
        "[", 
        RowBox[{
         RowBox[{"\[Pi]", "-", "\[Theta]"}], ",", "\[Phi]"}], "]"}]}], 
      ")"}]}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.893911609507628*^9, 3.893911792391792*^9}, {
  3.8939126693821774`*^9, 3.8939126694979258`*^9}},
 CellLabel->"In[1]:=",
 CellID->1152901163,ExpressionUUID->"7795424f-995c-478b-9b2d-73a9743254bc"],

Cell[TextData[{
 "It also satisfies the identity  ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
     SubscriptBox["S", 
      RowBox[{"l", "m"}]]}], 
    RowBox[{"(", 
     RowBox[{"\[Theta]", ",", 
      RowBox[{"\[Phi]", ";", "\[Gamma]"}]}], ")"}]}], "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"l", "+", "s"}]], 
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
     SubscriptBox[
      OverscriptBox["S", "_"], 
      RowBox[{"l", "-", "m"}]]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Pi]", "-", "\[Theta]"}], ",", 
      RowBox[{"\[Phi]", ";", 
       RowBox[{"-", "\[Gamma]"}]}]}], ")"}]}]}]],ExpressionUUID->
  "39149309-a0c8-40a5-b11a-f30462312cd3"],
 ":"
}], "ExampleText",
 CellChangeTimes->{{3.893911818021254*^9, 3.893911907432328*^9}, 
   3.893997524784135*^9},
 CellID->1505275450,ExpressionUUID->"7a27c9c1-4f51-4e28-8ebc-529fec6c8334"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "=", "2"}], ",", 
     RowBox[{"l", "=", "3"}], ",", 
     RowBox[{"m", "=", "2"}], ",", 
     RowBox[{"\[Gamma]", "=", "0.1"}], ",", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"\[Pi]", "/", "4"}]}], ",", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"\[Pi]", "/", "7"}]}]}], "}"}], ",", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{
      RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
       RowBox[{"s", ",", "l", ",", "m", ",", "\[Gamma]"}], "]"}], "[", 
