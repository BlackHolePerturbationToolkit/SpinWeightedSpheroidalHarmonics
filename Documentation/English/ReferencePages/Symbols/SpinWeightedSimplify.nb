Cell["\<\
If we only want to change the spin weight while leaving derivatives untouched \
we can do so via, \
\>", "ExampleText",
 CellChangeTimes->{{3.997248856052711*^9, 3.99724887691718*^9}, {
  3.99724897129286*^9, 3.997248979634246*^9}},
 CellID->1552241114,ExpressionUUID->"811732ee-d086-4bfc-b8ca-280e37e14b18"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "2", ",", "m", ",", "\[Theta]", ",", 
       "\[Phi]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", "2"}], "}"}]}], "]"}], "+", 
   RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "2", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}],
     "]"}]}], "//", 
  RowBox[{
   RowBox[{"SpinWeightedSimplify", "[", 
    RowBox[{"#", ",", 
     RowBox[{"\"\<YDerivatives\>\"", "->", "False"}], ",", 
     RowBox[{"\"\<s\>\"", "->", "0"}]}], "]"}], "&"}]}]], "Input",
 CellChangeTimes->{{3.997248912570744*^9, 3.997248958920068*^9}, {
  3.9973536880109453`*^9, 3.997353690117546*^9}},
 CellLabel->"In[1]:=",
 CellID->1300323557,ExpressionUUID->"83af6e2e-e5cc-4aef-80b5-9ea89ac90d1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{"m", "-", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], " ", 
      RowBox[{"Csc", "[", "\[Theta]", "]"}], " ", 
      InterpretationBox[
       FrameBox[
        RowBox[{
         SubscriptBox["", 
          RowBox[{"-", "1"}]], 
         SubscriptBox["Y", 
          RowBox[{"2", " \[InvisibleSpace]", "m"}]], 
         RowBox[{"[", "\[Theta]", ",", "\[Phi]", "]"}]}],
        Background->None,
        FrameMargins->{{0, 1}, {0, 0}},
        FrameStyle->None],
       SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[-1, 
        2, $CellContext`m, $CellContext`\[Theta], $CellContext`\[Phi]]]}], 
     "-", 
     RowBox[{
      SqrtBox["6"], " ", 
      InterpretationBox[
       FrameBox[
        RowBox[{
         SubscriptBox["", "0"], 
         SubscriptBox["Y", 
          RowBox[{"2", " \[InvisibleSpace]", "m"}]], 
         RowBox[{"[", "\[Theta]", ",", "\[Phi]", "]"}]}],
        Background->None,
        FrameMargins->{{0, 1}, {0, 0}},
        FrameStyle->None],
       SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[
       0, 2, $CellContext`m, $CellContext`\[Theta], $CellContext`\[Phi]]]}]}],
     ")"}]}], "+", 
  InterpretationBox[
   FrameBox[
    RowBox[{
     SubscriptBox["", 
      RowBox[{"-", "2"}]], 
     SubsuperscriptBox["Y", 
      RowBox[{"2", " \[InvisibleSpace]", "m"}], 
      RowBox[{"(", "2", ",", "0", ")"}]], 
     RowBox[{"[", "\[Theta]", ",", "\[Phi]", "]"}]}],
    Background->None,
    FrameMargins->{{0, 1}, {0, 0}},
    FrameStyle->None],
   Derivative[0, 0, 0, 2, 0][
   SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY][-2, 
    2, $CellContext`m, $CellContext`\[Theta], $CellContext`\[Phi]]]}]], \
"Output",
 CellChangeTimes->{{3.9972489314399*^9, 3.997248959237521*^9}, 
   3.997353526826941*^9, 3.9973536904888163`*^9, 3.998375580193565*^9, {
   3.998390344000431*^9, 3.998390349609799*^9}},
 CellLabel->"Out[1]=",
 CellID->1184301305,ExpressionUUID->"1fecc516-51a0-4f03-b3a1-f2c59e6a7121"]
}, Open  ]]
}, Open  ]],

