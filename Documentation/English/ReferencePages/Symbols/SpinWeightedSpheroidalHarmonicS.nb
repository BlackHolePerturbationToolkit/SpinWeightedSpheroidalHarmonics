Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sSlm", ",", 
       RowBox[{"s", "=", 
        RowBox[{"-", "2"}]}], ",", 
       RowBox[{"l", "=", "2"}], ",", 
