 CellChangeTimes->{
  3.89361716117342*^9, {3.893783690841851*^9, 3.8937836938217773`*^9}, {
   3.893783947013611*^9, 3.893783950084496*^9}},
 CellID->1696110740,ExpressionUUID->"47e5be6f-e8fb-4ac7-8b77-efb24a6c5943"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{"s", "=", "0"}]], "InlineFormula",ExpressionUUID->
  "19f16020-193e-4d84-88d6-c2d7e0da7b3e"],
 ", ",
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalHarmonicS",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicS"]], "InlineFormula",ExpressionUUID->
  "30ee540e-0228-4d6e-8ff8-2cfcb459c4e6"],
 "[0, l, m, \[Gamma], \[Theta], 0] is equivalent to ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    FractionBox[
     RowBox[{
      RowBox[{"2", "l"}], "+", "1"}], 
     RowBox[{"4", "\[Pi]"}]]], 
   SqrtBox[
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"l", "-", "m"}], ")"}], "!"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"l", "+", "m"}], ")"}], "!"}]]], 
   RowBox[{
    ButtonBox["SpheroidalPS",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/SpheroidalPS"], "[", 
    RowBox[{"l", ",", "m", ",", 
     RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}], ",", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"0793f834-34d7-4773-a9dd-37f24dad1bd9"],
 "."
}], "Notes",
 CellChangeTimes->{
  3.89361716816155*^9, {3.893783707078019*^9, 3.8937837576083517`*^9}, 
   3.893783861823656*^9, {3.893783911596445*^9, 3.893783935592285*^9}},
 CellID->835276902,ExpressionUUID->"a80cdbdb-355e-47f3-b6b3-12667e3078d0"],

Cell[TextData[{
 "For certain special arguments (in particular, with ",
 Cell[BoxData[
  RowBox[{"\[Gamma]", "=", "0"}]], "InlineFormula",ExpressionUUID->
  "a8fa2c5e-835a-44a5-82ac-d8d5528aab8b"],
 "), ",
