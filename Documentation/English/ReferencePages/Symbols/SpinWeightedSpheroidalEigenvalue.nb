Cell[TextData[{
 "Branch cuts in the complex-",
 Cell[BoxData[
 "\[Gamma]"], "InlineFormula",ExpressionUUID->
  "c1138950-a26d-4db5-8391-b91a7a64f994"],
 " plane can lead to ambiguities in the identification of an eigenvalue with \
a value for ",
 Cell[BoxData[
 "l"], "InlineFormula",ExpressionUUID->"0edb8d3d-9fa4-45a8-bb5e-4168c6b564af"],
 ":"
}], "ExampleText",
 CellChangeTimes->{{3.894443384638366*^9, 3.894443420312008*^9}},
 CellID->2016560619,ExpressionUUID->"196ea443-b61d-4bfc-a8a2-7ea1c1136d33"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"l", "=", "2"}], ",", 
     RowBox[{"m", "=", "2"}], ",", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{
       RowBox[{"-", "5.5`"}], "+", 
       RowBox[{"2.3`", " ", "\[ImaginaryI]"}]}]}]}], "}"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
         RowBox[{"0", ",", "l", ",", "m", ",", 
          RowBox[{"\[Gamma]", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "\[Theta]"}], "]"}]}]}], "]"}], "]"}], ",", 
       RowBox[{"Re", "[", 
        RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
         RowBox[{"0", ",", 
          RowBox[{"l", "+", "1"}], ",", "m", ",", 
