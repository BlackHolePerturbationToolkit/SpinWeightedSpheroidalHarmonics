Cell["SpeedUpSWSHSeries", "ObjectName",
 CellID->764413117,ExpressionUUID->"c39e7272-3356-451a-b619-2f1c08df5678"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f84b4bf2-b89d-452c-8bea-1301f2365791"],
 " \[WarningSign]SETTING TO TRUE UNPROTECTS SERIES\[WarningSign] \
SpeedUpSWSHSeries[True/False] speeds up small spheroidicity expansions of \
SpinWeightedSpheroidalHarmonicS and SpinWeightedSpheroidalEigenvalue. This is \
off by default."
