Cell[TextData[{
 ButtonBox["N",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/N"],
 " does not affect the arguments of a ",
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalHarmonicS",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicS"]], "InlineFormula",ExpressionUUID->
  "3d20f97d-a7f0-4c8f-b2b1-6f6ed131f300"],
 " as it has the ",
 ButtonBox["NHoldAll",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NHoldAll"],
 " attribute:"
}], "ExampleText",
 CellChangeTimes->{{3.893829312678051*^9, 3.89382934474853*^9}, {
   3.89382947157708*^9, 3.893829481688234*^9}, 3.893997760854123*^9},
 CellID->1366473817,ExpressionUUID->"0e06cb73-af1c-4909-95e6-89c9fd30d547"],

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
     RowBox[{"2", ",", "5", ",", "3", ",", 
      FractionBox["1", "10"]}], "]"}], "[", 
    RowBox[{
     RowBox[{"\[Pi]", "/", "4"}], ",", 
     RowBox[{"\[Pi]", "/", "3"}]}], "]"}], ",", "32"}], "]"}]], "Input",
 CellChangeTimes->{{3.893829347345773*^9, 3.893829356592473*^9}, {
  3.8938327699284477`*^9, 3.89383277205156*^9}},
 CellLabel->"In[1]:=",
 CellID->1980734569,ExpressionUUID->"32ce55bc-71ee-4d5d-bfb1-fe10693e04d8"],

Cell[TextData[{
 "This is because it does not make sense to numerically evaluate a harmonic \
without specifying numerical values for ",
 Cell[BoxData[
 "\[Theta]"], "InlineFormula",ExpressionUUID->
  "98af7d63-e7e0-415d-b561-7c53768cfdaf"],
 " and ",
 Cell[BoxData[
 "\[Phi]"], "InlineFormula",ExpressionUUID->
  "996c80d7-05c1-43ce-8700-471bf3f92bb8"],
 ". Instead, we can define a function that also takes values for ",
 Cell[BoxData[
 "\[Theta]"], "InlineFormula",ExpressionUUID->
  "6cec3198-fead-4a8a-a9ab-b5920d6ff29f"],
 " and ",
 Cell[BoxData[
 "\[Phi]"], "InlineFormula",ExpressionUUID->
  "ad17833e-bfcc-413d-970a-c8c1b8ed82cf"],
 " and behaves as expected with ",
 ButtonBox["N",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/N"],
 ":"
}], "ExampleText",
 CellChangeTimes->{{3.893829359658553*^9, 3.893829466244358*^9}},
 CellID->311256059,ExpressionUUID->"de99fc5b-b671-43f1-93f9-ddae9284333e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"SpinWeightedSpheroidalHarmonicSValue", ",", 
    RowBox[{"{", "NHoldFirst", "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SpinWeightedSpheroidalHarmonicSValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s_", ",", " ", "l_", ",", " ", "m_"}], "}"}], ",", " ", 
     RowBox[{"\[Gamma]_", "?", "InexactNumberQ"}], ",", " ", 
     RowBox[{"\[Theta]_", "?", "InexactNumberQ"}], ",", " ", 
     RowBox[{"\[Phi]_", "?", "InexactNumberQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
     RowBox[{"s", ",", " ", "l", ",", " ", "m", ",", " ", "\[Gamma]"}], "]"}],
     "[", 
    RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.893827762703635*^9, 3.893827766416982*^9}, {
  3.8938278577542257`*^9, 3.893827865261444*^9}, {3.8938285394691873`*^9, 
  3.893828541904153*^9}, {3.893828824835856*^9, 3.893828827110672*^9}},
 CellLabel->"In[2]:=",
 CellID->81217266,ExpressionUUID->"3b7ed274-34c7-4fbe-bb25-130dc79fc0ef"],

