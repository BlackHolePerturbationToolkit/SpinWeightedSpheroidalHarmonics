Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "=", "2"}], ",", 
     RowBox[{"l", "=", "3"}], ",", 
     RowBox[{"m", "=", "2"}], ",", 
     RowBox[{"\[Gamma]", "=", "0.1"}], ",", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"\[Pi]", "/", "4"}]}], ",", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"\[Pi]", "/", "7"}]}]}], "}"}], ",", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{
      RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
