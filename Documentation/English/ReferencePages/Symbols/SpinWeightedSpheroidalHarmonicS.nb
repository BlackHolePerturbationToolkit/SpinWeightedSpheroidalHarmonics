   RowBox[{
    StyleBox["\[Theta]", "TR"], ",", 
    StyleBox["\[Phi]", "TR"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c78fae73-7774-4d81-a712-9bbc25a4c960"],
 "\[LineSeparator]gives the spin-weighted spheroidal harmonic ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
