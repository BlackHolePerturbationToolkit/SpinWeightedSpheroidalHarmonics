Cell[BoxData[
 RowBox[{
  RowBox[{"s", " ", 
   RowBox[{"Cot", "[", "\[Theta]", "]"}], " ", 
   RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
    RowBox[{
    "s", ",", "\[ScriptL]", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
    "]"}]}], "+", 
  RowBox[{"m", " ", 
   RowBox[{"Csc", "[", "\[Theta]", "]"}], " ", 
   RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
    RowBox[{
    "s", ",", "\[ScriptL]", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
    "]"}]}], "-", 
  RowBox[{
   SqrtBox[
    RowBox[{
     RowBox[{"-", "s"}], "-", 
     SuperscriptBox["s", "2"], "+", "\[ScriptL]", "+", 
     SuperscriptBox["\[ScriptL]", "2"]}]], " ", 
   RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
    RowBox[{
     RowBox[{"1", "+", "s"}], ",", "\[ScriptL]", ",", "m", ",", "\[Theta]", 
     ",", "\[Phi]"}], "]"}]}]}]], "Output",
