SpinWeightedSpheroidalHarmonicS"], "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["l", "TI"], ",", 
    StyleBox["m", "TI"], ",", 
    StyleBox["\[Gamma]", "TR"]}], "]"}]], "InlineFormula",ExpressionUUID->
