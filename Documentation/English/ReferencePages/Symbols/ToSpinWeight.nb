  RowBox[{"(", 
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"m", "-", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], " ", 
