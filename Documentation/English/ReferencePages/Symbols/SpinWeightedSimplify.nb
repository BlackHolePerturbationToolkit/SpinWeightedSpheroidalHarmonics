 RowBox[{
  RowBox[{"s", " ", 
   RowBox[{"Cot", "[", "\[Theta]", "]"}], " ", 
   InterpretationBox[
    FrameBox[
     RowBox[{
      SubscriptBox["", "s"], 
      SubscriptBox["Y", 
       RowBox[{"\[ScriptL]", " \[InvisibleSpace]", "m"}]], 
      RowBox[{"[", "\[Theta]", ",", "\[Phi]", "]"}]}],
     Background->None,
     FrameMargins->{{0, 1}, {0, 0}},
     FrameStyle->None],
    SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, $CellContext`\[ScriptL], $CellContext`m, \
$CellContext`\[Theta], $CellContext`\[Phi]]]}], "+", 
  RowBox[{"m", " ", 
   RowBox[{"Csc", "[", "\[Theta]", "]"}], " ", 
   InterpretationBox[
