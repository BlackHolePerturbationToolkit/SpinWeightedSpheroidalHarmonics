Cell[CellGroupData[{

Cell["Numerical Evaluation", "ExampleSubsection",
 CellChangeTimes->{{3.893820880129674*^9, 3.8938208862640944`*^9}},
 CellID->90447048,ExpressionUUID->"40975d67-ebea-4825-b454-19c78e61fdb8"],

Cell[TextData[{
 "For numerical evaluation the double bracket structure is recommended. This \
is because one only needs s ",
 Cell[BoxData[
 "s"], "InlineFormula",ExpressionUUID->"abbf09fb-1cf7-4552-b1b6-85d288346f6c"],
 ", ",
 Cell[BoxData[
 "l"], "InlineFormula",ExpressionUUID->"4d4cf6c4-208e-413f-93c7-50b90f43a596"],
 ", ",
 Cell[BoxData[
 "m"], "InlineFormula",ExpressionUUID->"e3286afb-cca9-4156-9870-816f3c9f9d24"],
 " and ",
 Cell[BoxData[
 "\[Gamma]"], "InlineFormula",ExpressionUUID->
  "dfcae3aa-3ab3-4237-b579-0aa6907d1e5f"],
 " to evaluate the harmonic for a whole range of  of ",
 Cell[BoxData[
 "\[Theta]"], "InlineFormula",ExpressionUUID->
  "bf38a908-43d6-41df-8a17-97e28d2d46fc"],
 " and ",
 Cell[BoxData[
 "\[Phi]"], "InlineFormula",ExpressionUUID->
  "6b4213ce-39e3-4e7b-9be6-f2281bb22518"],
 ":"
}], "ExampleText",
 CellChangeTimes->{{3.8938209376711073`*^9, 3.8938209403051043`*^9}, 
   3.893997501415307*^9, {3.990248565132773*^9, 3.990248636987286*^9}, {
