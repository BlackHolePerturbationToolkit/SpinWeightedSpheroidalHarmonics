Cell[TextData[{
 "For  ",
 Cell[BoxData[
  RowBox[{"s", "=", "0"}]], "InlineFormula",ExpressionUUID->
  "076a3f2e-d6a6-4026-9420-e6e274606921"],
 ", ",
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalHarmonicS",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicS"]], "InlineFormula",ExpressionUUID->
  "3a2998bb-52fc-4cd9-b6a1-bb5a047c765d"],
 " is related to ",
 ButtonBox["SpheroidalPS",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SpheroidalPS"],
 ":"
}], "ExampleText",
 CellChangeTimes->{{3.8938296523948393`*^9, 3.893829691787931*^9}, 
   3.893997752852797*^9},
 CellID->1534990120,ExpressionUUID->"505d6592-b505-4885-8ee6-7e49d0fe0b56"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "=", "0"}], ",", 
     RowBox[{"l", "=", "2"}], ",", 
     RowBox[{"m", "=", "2"}], ",", 
     RowBox[{"\[Gamma]", "=", "0.1"}], ",", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"\[Pi]", "/", "4"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     SqrtBox[
      FractionBox[
       RowBox[{
        RowBox[{"2", "l"}], "+", "1"}], 
       RowBox[{"4", "\[Pi]"}]]], 
     SqrtBox[
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"l", "-", "m"}], ")"}], "!"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"l", "+", "m"}], ")"}], "!"}]]], 
     RowBox[{"SpheroidalPS", "[", 
      RowBox[{"l", ",", "m", ",", 
       RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}], ",", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "]"}]}], "==", 
    RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
     RowBox[{
     "s", ",", "l", ",", "m", ",", "\[Gamma]", ",", "\[Theta]", ",", "0"}], 
     "]"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.893829591915738*^9, 3.893829647188068*^9}, 
   3.997355517964583*^9},
 CellLabel->"In[38]:=",
 CellID->1240761238,ExpressionUUID->"3ff83be2-1f56-4e42-a178-eaf524a9f07e"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.997355518426652*^9},
 CellLabel->"Out[38]=",
 CellID->2078113150,ExpressionUUID->"b3f981cc-3ac8-4cb4-96cc-bc200f6d337d"]
}, Open  ]],

