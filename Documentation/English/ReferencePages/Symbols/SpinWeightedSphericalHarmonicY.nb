Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
  RowBox[{"2", ",", "5", ",", "3", ",", 
   RowBox[{"\[Pi]", "/", "4"}], ",", 
   RowBox[{"3", 
    RowBox[{"\[Pi]", "/", "4"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.8938209046625757`*^9, 3.893820953339425*^9}, {
  3.89399745312608*^9, 3.893997455335922*^9}},
 CellLabel->"In[2]:=",
 CellID->1106115503,ExpressionUUID->"363fcc1e-1b14-4617-9f19-905bd0bcd51e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["1", "128"]}], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"1", "-", 
     FractionBox["1", 
      SqrtBox["2"]]}], ")"}], "5"], " ", 
  RowBox[{"(", 
   RowBox[{"17", "+", 
    RowBox[{"12", " ", 
     SqrtBox["2"]}]}], ")"}], " ", 
  SuperscriptBox["\[ExponentialE]", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", "\[Pi]"}], "4"]], " ", 
  SqrtBox[
   FractionBox["33", 
    RowBox[{"2", " ", "\[Pi]"}]]], " ", 
  RowBox[{"Cot", "[", 
   FractionBox["\[Pi]", "8"], "]"}], " ", 
  SuperscriptBox[
   RowBox[{"Csc", "[", 
    FractionBox["\[Pi]", "8"], "]"}], "4"]}]], "Output",
 CellChangeTimes->{3.9983759578574343`*^9},
 CellLabel->"Out[2]=",
 CellID->24947188,ExpressionUUID->"9f3d8fa6-9325-4d5b-956e-492016469e81"]
}, Open  ]],

