     "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicS"], "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["l", "TI"], ",", 
    StyleBox["m", "TI"], ",", 
    StyleBox["\[Gamma]", "TR"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c9a75839-61e6-4d0b-9031-671f4157de41"],
