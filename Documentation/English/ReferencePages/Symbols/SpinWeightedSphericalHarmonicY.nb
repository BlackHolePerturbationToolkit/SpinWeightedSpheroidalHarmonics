Cell[TextData[{
 " ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
    SubscriptBox["Y", 
     RowBox[{"l", "m"}]]}], 
   RowBox[{"(", 
