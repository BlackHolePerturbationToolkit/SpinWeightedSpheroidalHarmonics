   3.893911971732584*^9, 3.893911997560934*^9}, 3.89399752662606*^9},
 CellID->701152851,ExpressionUUID->"c196a2c1-3195-4f07-84da-e0055451aa68"],

Cell[BoxData[
 RowBox[{"With", "[", 
