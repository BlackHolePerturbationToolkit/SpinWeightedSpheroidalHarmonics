Cell[CellGroupData[{

Cell["Series Expansions", "ExampleSubsection",
 CellChangeTimes->{{3.893870062481563*^9, 3.89387006574053*^9}},
 CellID->2129265023,ExpressionUUID->"0dbbba8e-888f-4b6a-9c27-d51bea000b25"],

Cell["The harmonics admit a series expansion around \[Gamma]=0.", \
"ExampleText",
 CellChangeTimes->{{3.990182006615787*^9, 3.99018204276754*^9}, {
  3.99018208240535*^9, 3.9901820840049877`*^9}, {3.990182544769604*^9, 
  3.990182545218172*^9}, {3.997355134214528*^9, 3.99735514770422*^9}},
 CellID->1574611435,ExpressionUUID->"a15e7b77-42ee-4968-8773-da1c897e430f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
   RowBox[{"s", ",", "l", ",", "m", ",", 
    RowBox[{"a", " ", "\[Omega]"}], ",", "\[Theta]", ",", "\[Phi]"}], "]"}], "//", 
  RowBox[{
   RowBox[{"Series", "[", 
    RowBox[{"#", ",", 
     RowBox[{"{", 
      RowBox[{"\[Omega]", ",", "0", ",", "1"}], "}"}]}], "]"}], 
   "&"}]}]], "Input",
 CellChangeTimes->{{3.990182053003744*^9, 3.9901820737733*^9}, {
  3.990182148161117*^9, 3.990182190191328*^9}},
 CellLabel->"In[11]:=",
 CellID->427184139,ExpressionUUID->"146ae7b9-c898-45ae-9da3-eddbdc97078a"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   InterpretationBox[
    TagBox[
     TemplateBox[{"s", "l", "m", "\[Theta]", "\[Phi]"},
      "MyCustomBox",
      DisplayFunction->(StyleBox[
        FrameBox[
         RowBox[{
           SubscriptBox["", #], 
           SubscriptBox["Y", 
            RowBox[{#2, " ", #3}]], 
           RowBox[{"[", #4, ",", #5, "]"}]}], Background -> None, FrameStyle -> 
         None, RoundingRadius -> 4, FrameMargins -> {{0, 1}, {0, 0}}]]& )],
     DisplayForm],
    SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]], "+", 
   RowBox[{"a", " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        SqrtBox[
         RowBox[{
          SuperscriptBox["l", "2"], "-", 
          SuperscriptBox["m", "2"]}]], " ", "s", " ", 
        SqrtBox[
         RowBox[{
          SuperscriptBox["l", "2"], "-", 
          SuperscriptBox["s", "2"]}]], " ", 
        InterpretationBox[
         TagBox[
          TemplateBox[{"s", 
            RowBox[{
              RowBox[{"-", "1"}], "+", "l"}], "m", "\[Theta]", "\[Phi]"},
           "MyCustomBox",
           DisplayFunction->(StyleBox[
             FrameBox[
              RowBox[{
                SubscriptBox["", #], 
                SubscriptBox["Y", 
                 RowBox[{#2, " ", #3}]], 
                RowBox[{"[", #4, ",", #5, "]"}]}], Background -> None, 
              FrameStyle -> None, RoundingRadius -> 4, 
              FrameMargins -> {{0, 1}, {0, 0}}]]& )],
          DisplayForm],
         SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, -1 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]]}], 
       RowBox[{
        SuperscriptBox["l", "2"], " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"2", " ", "l"}]}]], " ", 
        SqrtBox[
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "l"}]}]]}]], "-", 
      FractionBox[
       RowBox[{
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", "l"}], ")"}], "2"], "-", 
          SuperscriptBox["m", "2"]}]], " ", "s", " ", 
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", "l"}], ")"}], "2"], "-", 
          SuperscriptBox["s", "2"]}]], " ", 
        InterpretationBox[
         TagBox[
          TemplateBox[{"s", 
            RowBox[{"1", "+", "l"}], "m", "\[Theta]", "\[Phi]"},
           "MyCustomBox",
           DisplayFunction->(StyleBox[
             FrameBox[
              RowBox[{
                SubscriptBox["", #], 
                SubscriptBox["Y", 
                 RowBox[{#2, " ", #3}]], 
                RowBox[{"[", #4, ",", #5, "]"}]}], Background -> None, 
              FrameStyle -> None, RoundingRadius -> 4, 
              FrameMargins -> {{0, 1}, {0, 0}}]]& )],
          DisplayForm],
         SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, 
          1 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]]]}], 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "l"}], ")"}], "2"], " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "l"}], ")"}]}]}]], " ", 
        SqrtBox[
         RowBox[{"1", "+", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "l"}], ")"}]}]}]]}]]}], ")"}], " ", 
    "\[Omega]"}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Omega]", "]"}], "2"],
    SeriesData[$CellContext`\[Omega], 0, {}, 0, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Omega], 0, {
    SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]], $CellContext`a ($CellContext`l^(-2) (-1 + 
        2 $CellContext`l)^Rational[-1, 2] (1 + 2 $CellContext`l)^
       Rational[-1, 2] ($CellContext`l^2 - $CellContext`m^2)^
       Rational[1, 2] $CellContext`s ($CellContext`l^2 - $CellContext`s^2)^
       Rational[1, 2] 
      SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, -1 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]] - (1 + $CellContext`l)^(-2) (-1 + 
       2 (1 + $CellContext`l))^Rational[-1, 2] (1 + 2 (1 + $CellContext`l))^
      Rational[-1, 2] ((1 + $CellContext`l)^2 - $CellContext`m^2)^
      Rational[1, 
        2] $CellContext`s ((1 + $CellContext`l)^2 - $CellContext`s^2)^
      Rational[1, 2] 
     SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, 
       1 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]])}, 0, 2, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.990182069682068*^9, 3.9901820740633383`*^9}, {
   3.990182162832649*^9, 3.990182190434696*^9}, 3.993478371393097*^9, 
   3.993479103048832*^9, 3.997355154647101*^9},
 CellLabel->"Out[11]=",
 CellID->1642753075,ExpressionUUID->"eaea78ad-9465-42d9-8c3f-34c5e3200ccb"]
}, Open  ]],

Cell["\<\
This series expansion can be slow due to Mathematica's internal checks for \
branch cuts etc. \
\>", "ExampleText",
 CellChangeTimes->{{3.99735518427814*^9, 3.997355210266007*^9}},
 CellID->1294369810,ExpressionUUID->"bda32a17-57a3-42cf-bacd-ccb0beb8762f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EchoTiming", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Gamma]", " ", 
       RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
        RowBox[{
        "s", ",", "l", ",", "m", ",", "\[Gamma]", ",", "\[Theta]", ",", 
         "\[Phi]"}], "]"}]}], "//", 
      RowBox[{
       RowBox[{"Series", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"\[Gamma]", ",", "0", ",", "4"}], "}"}]}], "]"}], "&"}]}], 
     ",", "\"\<Slow Series\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.990182209790009*^9, 3.990182272062625*^9}, {
  3.9902480380360947`*^9, 3.990248058169689*^9}, {3.997355231304541*^9, 
  3.997355243107038*^9}},
 CellLabel->"In[24]:=",
 CellID->1828832044,ExpressionUUID->"2a17f02b-1671-44fd-a2bb-aae3280ef60f"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Slow Series\"\>",
   "EchoLabel"], "  ", "6.600885`"}]], "EchoTiming",
 CellChangeTimes->{3.997355393297526*^9},
 CellID->1752166810,ExpressionUUID->"9b7807c4-3a65-49e4-a938-3a7285e27c00"]
}, Open  ]],

Cell["\<\
However this can be circumvented through SetSpinWeightedOptions. Note that \
this Unprotects Series!\
\>", "ExampleText",
 CellChangeTimes->{{3.990182127663187*^9, 3.990182129185611*^9}, {
   3.990182202378121*^9, 3.99018220728134*^9}, 3.990182410286602*^9, {
   3.990247951980982*^9, 3.990247979786212*^9}, {3.990248092256684*^9, 
   3.990248092536204*^9}, {3.993478582002739*^9, 3.9934786637411137`*^9}, {
   3.997355254125614*^9, 3.9973552720462847`*^9}},
 CellID->304404965,ExpressionUUID->"5358c8f6-843a-4634-ae84-d1df10014c8f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinWeightedOptions", "[", 
   RowBox[{"\"\<OverloadSeries\>\"", "\[Rule]", "False"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EchoTiming", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Gamma]", " ", 
      RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
       RowBox[{
       "s", ",", "l", ",", "m", ",", "\[Gamma]", ",", "\[Theta]", ",", 
        "\[Phi]"}], "]"}]}], "//", 
     RowBox[{
      RowBox[{"Series", "[", 
       RowBox[{"#", ",", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]", ",", "0", ",", "4"}], "}"}]}], "]"}], "&"}]}], 
    ",", "\"\<Slow Series\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetSpinWeightedOptions", "[", 
   RowBox[{"\"\<OverloadSeries\>\"", "\[Rule]", "True"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EchoTiming", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Gamma]", " ", 
      RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
       RowBox[{
       "s", ",", "l", ",", "m", ",", "\[Gamma]", ",", "\[Theta]", ",", 
        "\[Phi]"}], "]"}]}], "//", 
     RowBox[{
      RowBox[{"Series", "[", 
       RowBox[{"#", ",", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]", ",", "0", ",", "4"}], "}"}]}], "]"}], "&"}]}], 
    ",", "\"\<Fast Series\>\""}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9934786649568367`*^9, 3.993478680556275*^9}, {
  3.997355296053749*^9, 3.9973553188500433`*^9}},
 CellLabel->"In[31]:=",
 CellID->1659892065,ExpressionUUID->"af020697-4176-43b1-b541-0ceebf3e4c23"],

