    SubscriptBox["", 
     RowBox[{"-", "2"}]], 
    SubsuperscriptBox["Y", 
     RowBox[{"2", " \[InvisibleSpace]", "m"}], 
     RowBox[{"(", "1", ",", "0", ")"}]], 
    RowBox[{"[", "\[Theta]", ",", "\[Phi]", "]"}]}],
   Background->None,
   FrameMargins->{{0, 1}, {0, 0}},
   FrameStyle->None],
  Derivative[0, 0, 0, 1, 0][
  SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY][-2, 
   2, $CellContext`m, $CellContext`\[Theta], $CellContext`\[Phi]]]], "Output",\

