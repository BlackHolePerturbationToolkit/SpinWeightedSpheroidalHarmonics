Cell["The spheroidal equation is ", "ExampleText",
 CellChangeTimes->{{3.9973556967951927`*^9, 3.9973557057984962`*^9}},
 CellID->1244737103,ExpressionUUID->"89887a63-01de-416c-be73-0fd347c12034"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SpheroidalEquation", "[", 
   RowBox[{
   "s_", ",", "\[ScriptL]_", ",", "m_", ",", "\[Gamma]_", ",", 
    "\[CurlyTheta]_", ",", "\[CurlyPhi]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"aux", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"aux", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
          RowBox[{
          "s", ",", "\[ScriptL]", ",", "m", ",", "\[Gamma]", ",", "\[Theta]", 
           ",", "\[Phi]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Theta]", ",", "2"}], "}"}]}], "]"}], "+", 
       RowBox[{
        RowBox[{"Cot", "[", "\[Theta]", "]"}], 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
           RowBox[{
           "s", ",", "\[ScriptL]", ",", "m", ",", "\[Gamma]", ",", "\[Theta]",
             ",", "\[Phi]"}], "]"}], ",", "\[Theta]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "\[Gamma]", " ", 
           RowBox[{"(", 
            RowBox[{"m", "-", 
             RowBox[{"s", " ", 
              RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}]}], "-", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"m", "+", 
              RowBox[{"s", " ", 
               RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "^", "2"}], 
           "/", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}], "+", 
          RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
           RowBox[{"s", ",", "\[ScriptL]", ",", "m", ",", "\[Gamma]"}], "]"}],
           "+", "s", "-", 
          RowBox[{
           RowBox[{"\[Gamma]", "^", "2"}], " ", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}], ")"}], 
        RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
         RowBox[{
         "s", ",", "\[ScriptL]", ",", "m", ",", "\[Gamma]", ",", "\[Theta]", 
          ",", "\[Phi]"}], "]"}]}]}]}], ";", "\n", 
     RowBox[{"aux", "=", 
      RowBox[{"aux", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Theta]", "->", "\[CurlyTheta]"}], ",", 
         RowBox[{"\[Phi]", "->", "\[CurlyPhi]"}]}], "}"}]}]}], ";", "\n", 
     "aux"}]}], "\n", "]"}]}]], "Input",
 CellChangeTimes->{{3.997355709851468*^9, 3.997355714441595*^9}},
 CellLabel->"In[93]:=",
 CellID->795041275,ExpressionUUID->"ca276a5e-b388-4a11-b82c-72be29dea998"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SpheroidalEquation", "[", 
  RowBox[{
  "s", ",", "l", ",", "m", ",", "\[Gamma]", ",", "\[Theta]", ",", "\[Phi]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.997355719910334*^9, 3.997355741454514*^9}},
 CellLabel->"In[94]:=",
 CellID->2074867895,ExpressionUUID->"c958a0e4-792f-45d1-96af-908f62af2a18"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"s", "+", 
     RowBox[{"2", " ", "\[Gamma]", " ", 
      RowBox[{"(", 
       RowBox[{"m", "-", 
        RowBox[{"s", " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}]}], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"m", "+", 
         RowBox[{"s", " ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"]}], "-", 
     RowBox[{
      SuperscriptBox["\[Gamma]", "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "+", 
     InterpretationBox[
      FrameBox[
       RowBox[{
        SubscriptBox["", "s"], 
        SubscriptBox["\[Lambda]", 
         RowBox[{"l", " ", "m"}]], 
        RowBox[{"[", "\[Gamma]", "]"}]}],
       Background->None,
       FrameMargins->{{0, 1}, {0, 0}},
       FrameStyle->None],
      SpinWeightedSpheroidalHarmonics`SpinWeightedSpheroidalEigenvalue[$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\[Gamma]]]}], 
    ")"}], " ", 
   InterpretationBox[
    FrameBox[
     RowBox[{
      SubscriptBox["", "s"], 
      SubscriptBox["S", 
       RowBox[{"l", " \[InvisibleSpace]", "m"}]], 
      RowBox[{"[", "\[Gamma]", ",", "\[Theta]", ",", "\[Phi]", "]"}]}],
     Background->None,
     FrameMargins->{{0, 1}, {0, 0}},
     FrameStyle->None],
    SpinWeightedSpheroidalHarmonics`SpinWeightedSpheroidalHarmonicS[$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\[Gamma], \
$CellContext`\[Theta], $CellContext`\[Phi]]]}], "+", 
  RowBox[{
   RowBox[{"Cot", "[", "\[Theta]", "]"}], " ", 
   InterpretationBox[
    FrameBox[
     RowBox[{
      SubscriptBox["", "s"], 
      SubsuperscriptBox["S", 
       RowBox[{"l", " \[InvisibleSpace]", "m"}], 
       RowBox[{"(", "0", ",", "1", ",", "0", ")"}]], 
      RowBox[{"[", "\[Gamma]", ",", "\[Theta]", ",", "\[Phi]", "]"}]}],
     Background->None,
     FrameMargins->{{0, 1}, {0, 0}},
     FrameStyle->None],
    Derivative[0, 0, 0, 0, 1, 0][
    SpinWeightedSpheroidalHarmonics`SpinWeightedSpheroidalHarmonicS][$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\[Gamma], \
$CellContext`\[Theta], $CellContext`\[Phi]]]}], "+", 
  InterpretationBox[
   FrameBox[
    RowBox[{
     SubscriptBox["", "s"], 
     SubsuperscriptBox["S", 
      RowBox[{"l", " \[InvisibleSpace]", "m"}], 
      RowBox[{"(", "0", ",", "2", ",", "0", ")"}]], 
     RowBox[{"[", "\[Gamma]", ",", "\[Theta]", ",", "\[Phi]", "]"}]}],
    Background->None,
    FrameMargins->{{0, 1}, {0, 0}},
    FrameStyle->None],
   Derivative[0, 0, 0, 0, 2, 0][
   SpinWeightedSpheroidalHarmonics`SpinWeightedSpheroidalHarmonicS][$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\[Gamma], \
$CellContext`\[Theta], $CellContext`\[Phi]]]}]], "Output",
 CellChangeTimes->{3.997355741762311*^9, 3.99837673025268*^9},
 CellLabel->"Out[94]=",
 CellID->912067122,ExpressionUUID->"c89fb1ca-9547-4a18-99f7-8622cf807d05"]
}, Open  ]],

