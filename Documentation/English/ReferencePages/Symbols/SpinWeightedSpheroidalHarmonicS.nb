SpinWeightedSpheroidalHarmonicS"]], "InlineFormula",ExpressionUUID->
  "dd38b627-ecf3-42d8-936d-75a8e6229414"],
 " automatically threads over lists."
}], "Notes",
 CellChangeTimes->{{3.893820021442511*^9, 3.893820029297389*^9}, {
  3.893820299653457*^9, 3.8938203038263283`*^9}},
 CellID->831908044,ExpressionUUID->"59dfa7aa-5c45-4dde-b567-746965aeaccb"],

Cell[TextData[{
 "For numerical values of ",
 Cell[BoxData[
 "\[Gamma]"], "InlineFormula",ExpressionUUID->
  "d5920402-3e83-4aea-9f58-0c74424cd492"],
 ", ",
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalHarmonicS",
