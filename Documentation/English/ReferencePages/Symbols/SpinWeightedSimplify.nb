Cell[BoxData[
 InterpretationBox[
  TagBox[
   TemplateBox[{
     RowBox[{"1", "+", "s"}], "l", "m", "\[Theta]", "\[Phi]", "1", "0"},
    "MyCustomBox",
    DisplayFunction->(StyleBox[
      FrameBox[
       RowBox[{
         SubscriptBox["", #], 
