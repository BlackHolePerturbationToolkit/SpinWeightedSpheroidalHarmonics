  RowBox[{
   RowBox[{"EvaluateSpinZero", "[", 
    RowBox[{"True", "/", "False"}], "]"}], "turns", " ", 
   RowBox[{"on", "/", "off"}], " ", "automatic", " ", "evaluation", " ", "of",
    " ", 
