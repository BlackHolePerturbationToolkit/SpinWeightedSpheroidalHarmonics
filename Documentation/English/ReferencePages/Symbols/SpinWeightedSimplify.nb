    SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, $CellContext`\[ScriptL], $CellContext`m, \
$CellContext`\[Theta], $CellContext`\[Phi]]]}], "-", 
  RowBox[{
   SqrtBox[
    RowBox[{
     RowBox[{"-", "s"}], "-", 
