  RowBox[{
   RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
    RowBox[{"s", ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], 
   "+", 
   RowBox[{"a", " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        SqrtBox[
         RowBox[{
          SuperscriptBox["l", "2"], "-", 
          SuperscriptBox["m", "2"]}]], " ", "s", " ", 
        SqrtBox[
         RowBox[{
          SuperscriptBox["l", "2"], "-", 
          SuperscriptBox["s", "2"]}]], " ", 
        RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
         RowBox[{"s", ",", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "l"}], ",", "m", ",", "\[Theta]", ",", 
          "\[Phi]"}], "]"}]}], 
       RowBox[{
        SuperscriptBox["l", "2"], " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"2", " ", "l"}]}]], " ", 
        SqrtBox[
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "l"}]}]]}]], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SqrtBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", "l"}], ")"}], "2"], "-", 
           SuperscriptBox["m", "2"]}]], " ", "s", " ", 
         SqrtBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", "l"}], ")"}], "2"], "-", 
           SuperscriptBox["s", "2"]}]], " ", 
         RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
          RowBox[{"s", ",", 
           RowBox[{"1", "+", "l"}], ",", "m", ",", "\[Theta]", ",", 
           "\[Phi]"}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", "l"}], ")"}], "2"], " ", 
         SqrtBox[
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", "l"}], ")"}]}]}]], " ", 
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", "l"}], ")"}]}]}]]}], ")"}]}]}], ")"}], " ", 
    "\[Omega]"}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Omega]", "]"}], "2"],
    SeriesData[$CellContext`\[Omega], 0, {}, 0, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Omega], 0, {
    SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]], $CellContext`a ($CellContext`l^(-2) (-1 + 
        2 $CellContext`l)^Rational[-1, 2] (1 + 2 $CellContext`l)^
       Rational[-1, 2] ($CellContext`l^2 - $CellContext`m^2)^
       Rational[1, 2] $CellContext`s ($CellContext`l^2 - $CellContext`s^2)^
       Rational[1, 2] 
      SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, -1 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]] - (1 + $CellContext`l)^(-2) (-1 + 
       2 (1 + $CellContext`l))^Rational[-1, 2] (1 + 2 (1 + $CellContext`l))^
      Rational[-1, 2] ((1 + $CellContext`l)^2 - $CellContext`m^2)^
      Rational[1, 
        2] $CellContext`s ((1 + $CellContext`l)^2 - $CellContext`s^2)^
      Rational[1, 2] 
     SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[$\
CellContext`s, 
       1 + $CellContext`l, $CellContext`m, $CellContext`\[Theta], \
$CellContext`\[Phi]])}, 0, 2, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.990182069682068*^9, 3.9901820740633383`*^9}, {
  3.990182162832649*^9, 3.990182190434696*^9}},
 CellLabel->"Out[83]=",
 CellID->55133862,ExpressionUUID->"dd5b9544-7880-44fe-8da4-6d04a699b3f8"]
}, Open  ]],

