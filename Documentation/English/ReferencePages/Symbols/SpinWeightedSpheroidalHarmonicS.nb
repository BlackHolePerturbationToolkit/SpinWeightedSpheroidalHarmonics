Cell[TextData[{
 "For certain special arguments (in particular, with ",
 Cell[BoxData[
  RowBox[{"\[Gamma]", "=", "0"}]], "InlineFormula",ExpressionUUID->
  "a6786815-1408-4d5f-9562-c4d1965b42e9"],
 "), ",
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalHarmonicS",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicS"]], "InlineFormula",ExpressionUUID->
  "0d0f1c93-517a-4bf7-9070-d5bea7820848"],
 "  automatically evaluates to exact values:"
}], "Notes",
 CellChangeTimes->{{3.893820057482781*^9, 3.8938200851994257`*^9}, {
  3.893997758478752*^9, 3.893997758739626*^9}},
 CellID->1302272401,ExpressionUUID->"8f96cdfb-b29f-4023-ae12-86ca65696676"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
  RowBox[{"2", ",", "3", ",", "2", ",", "0", ",", "\[Theta]", ",", "\[Phi]"}],
   "]"}]], "Input",
 CellChangeTimes->{{3.893836210581607*^9, 3.893836217991107*^9}, 
   3.997355503688601*^9},
 CellLabel->"In[35]:=",
 CellID->1208025018,ExpressionUUID->"2e403ec4-a50b-4f54-9409-469d60f67801"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "32"], " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Phi]"}]], " ", 
  SqrtBox[
   FractionBox["7", "\[Pi]"]], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], "4"], " ", 
  RowBox[{"(", 
   RowBox[{"2", "+", 
    RowBox[{"3", " ", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], " ", 
  SuperscriptBox[
   RowBox[{"Csc", "[", 
    FractionBox["\[Theta]", "2"], "]"}], "4"]}]], "Output",
 CellChangeTimes->{3.9973555043652887`*^9},
 CellLabel->"Out[35]=",
 CellID->850668767,ExpressionUUID->"44e085e5-5c63-44ee-af67-b08c0e78ed65"]
}, Open  ]]
}, Open  ]],

