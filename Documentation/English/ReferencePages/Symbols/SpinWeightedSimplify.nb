Cell["Or for the l-modes:", "ExampleText",
 CellChangeTimes->{{3.997356206522826*^9, 3.9973562283694363`*^9}},
 CellID->1440772470,ExpressionUUID->"4daf3b65-5aee-40da-8c52-dcd75600dd1c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SpheroidalEquation", "[", 
   RowBox[{
   "s_", ",", "\[ScriptL]_", ",", "m_", ",", "\[Gamma]_", ",", 
    "\[CurlyTheta]_", ",", "\[CurlyPhi]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"aux", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"aux", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
          RowBox[{
          "s", ",", "\[ScriptL]", ",", "m", ",", "\[Gamma]", ",", "\[Theta]", 
           ",", "\[Phi]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Theta]", ",", "2"}], "}"}]}], "]"}], "+", 
       RowBox[{
        RowBox[{"Cot", "[", "\[Theta]", "]"}], 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
           RowBox[{
           "s", ",", "\[ScriptL]", ",", "m", ",", "\[Gamma]", ",", "\[Theta]",
             ",", "\[Phi]"}], "]"}], ",", "\[Theta]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "\[Gamma]", " ", 
           RowBox[{"(", 
            RowBox[{"m", "-", 
             RowBox[{"s", " ", 
              RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}]}], "-", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"m", "+", 
              RowBox[{"s", " ", 
               RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "^", "2"}], 
           "/", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}], "+", 
          RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
           RowBox[{"s", ",", "\[ScriptL]", ",", "m", ",", "\[Gamma]"}], "]"}],
           "+", "s", "-", 
          RowBox[{
           RowBox[{"\[Gamma]", "^", "2"}], " ", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}], ")"}], 
        RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
         RowBox[{
         "s", ",", "\[ScriptL]", ",", "m", ",", "\[Gamma]", ",", "\[Theta]", 
          ",", "\[Phi]"}], "]"}]}]}]}], ";", "\n", 
     RowBox[{"aux", "=", 
      RowBox[{"aux", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Theta]", "->", "\[CurlyTheta]"}], ",", 
         RowBox[{"\[Phi]", "->", "\[CurlyPhi]"}]}], "}"}]}]}], ";", "\n", 
     "aux"}]}], "\n", "]"}]}]], "Input",
 CellChangeTimes->{{3.997355709851468*^9, 3.997355714441595*^9}},
 CellLabel->"In[95]:=",
 CellID->795041275,ExpressionUUID->"40e32f4f-d22b-42e6-8dc4-a3815b2479d8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"SpheroidalEquation", "[", 
       RowBox[{"s", ",", 
        RowBox[{"l", "+", "1"}], ",", "m", ",", "\[Gamma]", ",", "\[Theta]", 
        ",", "\[Phi]"}], "]"}], "//", 
      RowBox[{
       RowBox[{"Series", "[", 
