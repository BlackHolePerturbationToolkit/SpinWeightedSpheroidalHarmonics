Cell["\<\
We can use a combination of DerivativeToYslm and ToSpinWeight to implement \
the Schwarzschild \[Eth] and \[Eth]' as spin raising and lowering operators \
\>", "ExampleText",
 CellChangeTimes->{{3.990180812680575*^9, 3.990180878303454*^9}},
 CellID->89482782,ExpressionUUID->"8761a5f6-47a0-435a-a1df-29525f9927aa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Eth]", "[", 
    RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
     RowBox[{
     "s_", ",", "\[ScriptL]_", ",", "m_", ",", "\[Theta]", ",", "\[Phi]"}], 
     "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{
        SqrtBox["2"], "r"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"#", ",", "\[Theta]"}], "]"}], "+", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"Csc", "[", "\[Theta]", "]"}], 
         RowBox[{"D", "[", 
          RowBox[{"#", ",", "\[Phi]"}], "]"}]}], "-", 
        RowBox[{"s", " ", 
         RowBox[{"Cot", "[", "\[Theta]", "]"}], "#"}]}], ")"}]}], "&"}], "@", 
    
    RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
     RowBox[{
     "s", ",", "\[ScriptL]", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Eth]p", "[", 
    RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
     RowBox[{
     "s_", ",", "\[ScriptL]_", ",", "m_", ",", "\[Theta]", ",", "\[Phi]"}], 
     "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{
        SqrtBox["2"], "r"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"#", ",", "\[Theta]"}], "]"}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"Csc", "[", "\[Theta]", "]"}], 
         RowBox[{"D", "[", 
          RowBox[{"#", ",", "\[Phi]"}], "]"}]}], "+", 
        RowBox[{"s", " ", 
         RowBox[{"Cot", "[", "\[Theta]", "]"}], "#"}]}], ")"}]}], "&"}], "@", 
    
    RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
     RowBox[{
     "s", ",", "\[ScriptL]", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
     "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9901804003248034`*^9, 3.9901804073205013`*^9}, {
  3.990180456682281*^9, 3.990180572608306*^9}, {3.990180603112076*^9, 
  3.990180608035858*^9}, {3.990180641515926*^9, 3.990180701209926*^9}, {
