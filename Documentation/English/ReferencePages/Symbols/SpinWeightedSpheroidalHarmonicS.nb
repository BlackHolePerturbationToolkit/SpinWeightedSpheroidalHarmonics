 "Transform from ",
 Cell[BoxData[
  RowBox[{"s", "=", 
   RowBox[{"-", "1"}]}]], "InlineFormula",ExpressionUUID->
  "c8801ad5-b52a-45a6-8c4e-b8c9c9f30530"],
 " to ",
