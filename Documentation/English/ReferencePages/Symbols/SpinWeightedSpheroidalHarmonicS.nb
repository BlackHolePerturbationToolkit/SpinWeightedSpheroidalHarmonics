Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalHarmonicS",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicS"]], "InlineFormula",ExpressionUUID->
  "a5febc8b-18ea-46dc-baa9-feff711d60cd"],
 " satisfies the Teukolsky-Starobinsky identities relating harmonics with \
different ",
 Cell[BoxData[
 "s"], "InlineFormula",ExpressionUUID->"6d46cfee-702e-4d52-9608-d5a052820257"],
 ". These are given in terms of differential operators ",
 Cell[BoxData[
 "\[ScriptCapitalL]"], "InlineFormula",ExpressionUUID->
  "c8e8ddf6-b0dc-47d3-b4dd-ee0407f4afc5"],
 " and ",
 Cell[BoxData[
  SuperscriptBox["\[ScriptCapitalL]", "\[Dagger]"]], "InlineFormula",
  ExpressionUUID->"89769631-b42c-4139-9d56-4a14735038fd"],
 " and a constant \[ScriptCapitalD]:"
}], "ExampleText",
 CellChangeTimes->{{3.893911818021254*^9, 3.8939118695704*^9}, {
   3.893918737751254*^9, 3.893918772455801*^9}, {3.8939975493399987`*^9, 
   3.893997596808371*^9}, 3.8939989464337263`*^9},
 CellID->263426161,ExpressionUUID->"aca8d539-cfb2-4f12-ac4d-af9ba8e51c21"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalL]\[Dagger]", "[", "n_", "]"}], "[", "x_", "]"}], 
   ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Q", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[Gamma]"}], " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "+", 
        RowBox[{"m", " ", 
         RowBox[{"Csc", "[", "\[Theta]", "]"}]}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"x", ",", "\[Theta]"}], "]"}], "-", 
      RowBox[{"Q", " ", "x"}], "+", 
      RowBox[{"n", " ", 
       RowBox[{"Cot", "[", "\[Theta]", "]"}], "x"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalL]", "[", "n_", "]"}], "[", "x_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Q", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[Gamma]"}], " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "+", 
        RowBox[{"m", " ", 
         RowBox[{"Csc", "[", "\[Theta]", "]"}]}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"x", ",", "\[Theta]"}], "]"}], "+", 
      RowBox[{"Q", " ", "x"}], "+", 
      RowBox[{"n", " ", 
       RowBox[{"Cot", "[", "\[Theta]", "]"}], "x"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Dl", "[", 
    RowBox[{"l_", ",", "m_", ",", "a\[Omega]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Lambda]CH", "=", 
       RowBox[{
        RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
         RowBox[{"2", ",", "l", ",", "m", ",", "a\[Omega]"}], "]"}], "+", 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{"2", "+", "1"}], ")"}]}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Sqrt]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Lambda]CH", "2"], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Lambda]CH", "-", "2"}], ")"}], "2"]}], "+", 
        RowBox[{"8", "a\[Omega]", 
         RowBox[{"(", 
          RowBox[{"m", "-", "a\[Omega]"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"\[Lambda]CH", "-", "2"}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"5", "\[Lambda]CH"}], "-", "4"}], ")"}]}], "+", 
        RowBox[{"48", 
         SuperscriptBox[
          RowBox[{"(", "a\[Omega]", ")"}], "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            RowBox[{"(", 
             RowBox[{"\[Lambda]CH", "-", "2"}], ")"}]}], "+", 
           RowBox[{"3", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"m", "-", "a\[Omega]"}], ")"}], "2"]}]}], ")"}]}]}], 
       ")"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Dls1", "[", 
    RowBox[{"l_", ",", "m_", ",", "a\[Omega]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Lambda]CH", "=", 
       RowBox[{
        RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
         RowBox[{"1", ",", "l", ",", "m", ",", "a\[Omega]"}], "]"}], "+", 
        RowBox[{"1", 
         RowBox[{"(", 
          RowBox[{"1", "+", "1"}], ")"}]}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["\[Lambda]CH", "2"], "+", 
       RowBox[{"4", "a\[Omega]", 
        RowBox[{"(", 
         RowBox[{"m", "-", "a\[Omega]"}], ")"}]}]}]]}], "\[IndentingNewLine]",
     "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.89391877509403*^9, 3.893918789087553*^9}, {
