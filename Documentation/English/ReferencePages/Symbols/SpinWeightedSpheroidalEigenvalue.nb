 CellID->901249673,ExpressionUUID->"0ded52a7-87e6-421b-b293-f8bc9f0a3b7a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
    RowBox[{"s", ",", "l", ",", "m", ",", "\[Gamma]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Gamma]", ",", "0", ",", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.89442720208798*^9, 3.8944272232936893`*^9}},
 CellLabel->"In[7]:=",
 CellID->1101091820,ExpressionUUID->"0da84dd4-a84f-49f6-9f6e-38d353ce2ca6"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{"l", "+", 
     SuperscriptBox["l", "2"], "-", 
     RowBox[{"s", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "s"}], ")"}]}]}], ")"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "m"}], "-", 
      FractionBox[
       RowBox[{"2", " ", "m", " ", 
        SuperscriptBox["s", "2"]}], 
       RowBox[{"l", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "l"}], ")"}]}]]}], ")"}], " ", "\[Gamma]"}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Gamma]", "]"}], "2"],
    SeriesData[$CellContext`\[Gamma], 0, {}, 0, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Gamma], 
   0, {$CellContext`l + $CellContext`l^2 - $CellContext`s (
     1 + $CellContext`s), (-2) $CellContext`m - 
    2 $CellContext`l^(-1) (
      1 + $CellContext`l)^(-1) $CellContext`m $CellContext`s^2}, 0, 2, 1],
  Editable->False]], "Output",
 CellChangeTimes->{3.998376042067915*^9},
 CellLabel->"Out[7]=",
 CellID->1365293209,ExpressionUUID->"ee37829a-bc15-46ee-a32e-4c698e2f4e6a"]
}, Open  ]]
}, Open  ]],

