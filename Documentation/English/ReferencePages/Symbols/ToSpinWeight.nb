      RowBox[{"0", ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
      "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.990181634140852*^9},
 CellLabel->"Out[73]=",
 CellID->590936162,ExpressionUUID->"f6eeccf6-98b0-4225-800f-a0628ca421a5"]
}, Open  ]]
