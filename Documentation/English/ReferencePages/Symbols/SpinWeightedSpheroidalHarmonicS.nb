          RowBox[{"-", "s"}], ",", "l", ",", "m", ",", "\[Gamma]"}], "]"}], 
        "[", 
        RowBox[{
         RowBox[{"\[Pi]", "-", "\[Theta]"}], ",", "\[Phi]"}], "]"}]}], 
      ")"}]}]}]}], "]"}]], "Input",
