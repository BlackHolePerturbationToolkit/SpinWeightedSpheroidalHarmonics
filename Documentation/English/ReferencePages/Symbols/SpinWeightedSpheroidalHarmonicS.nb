Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalHarmonicS",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicS"]], "InlineFormula",ExpressionUUID->
  "c9180227-0eef-4605-845f-114d344cab31"],
 " satisfies the identity  ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
     SubscriptBox["S", 
      RowBox[{"l", "m"}]]}], 
    RowBox[{"(", 
     RowBox[{"\[Theta]", ",", 
      RowBox[{"\[Phi]", ";", "\[Gamma]"}]}], ")"}]}], "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"l", "+", "m"}]], 
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", 
      RowBox[{"-", "s"}]], 
     SubscriptBox["S", 
      RowBox[{"l", "m"}]]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Pi]", "-", "\[Theta]"}], ",", 
      RowBox[{"\[Phi]", ";", "\[Gamma]"}]}], ")"}]}]}]],ExpressionUUID->
  "27a42116-a45c-4917-9de3-32b7bb473d09"],
 ":"
}], "ExampleText",
