 CellID->398291475,ExpressionUUID->"17d6d630-3880-4438-9805-ab63a93552c7"],

Cell["\<\
Numerical values are computed using either Leaver's method or an expansion in \
terms of spin-weighted spherical harmonics.\
\>", "Notes",
 CellChangeTimes->{3.893617192128092*^9},
 CellID->378292626,ExpressionUUID->"46c5913e-84bc-43bf-a1b5-7e08d9b90f51"],

Cell[TextData[{
 "The number of terms used for numerical evaluation is such that the \
normalisation is determined as accurately as possible given the precision of \
the input ",
 Cell[BoxData[
 "\[Gamma]"], "InlineFormula",ExpressionUUID->
  "66e8c724-7906-4d7d-ae98-1c22918b1406"],
 "."
}], "Notes",
