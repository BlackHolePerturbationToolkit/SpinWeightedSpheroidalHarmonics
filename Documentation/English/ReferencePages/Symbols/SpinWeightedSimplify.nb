   ExpressionUUID->"798c6dc1-4b06-40ba-a286-89527480dd16"],
  $Line = 0; Null]], "ExampleSubsection",
 CellChangeTimes->{{3.997353491719511*^9, 3.997353491719527*^9}, {
  3.997355948682316*^9, 3.997355962581465*^9}},
 CellID->828462629,ExpressionUUID->"1ed238df-76b5-4e33-8698-a1ea013a4d95"],

Cell["\<\
We can use SpinWeightedSimplify to implement the Schwarzschild \[Eth] and \
\[Eth]' as spin raising and lowering operators \
\>", "ExampleText",
 CellChangeTimes->{{3.990180812680575*^9, 3.990180878303454*^9}, {
  3.997249077674461*^9, 3.9972490933733883`*^9}},
 CellID->89482782,ExpressionUUID->"5b122f3d-b840-43aa-8fa8-713d042f33be"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Eth]", "[", 
    RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
     RowBox[{
     "s_", ",", "\[ScriptL]_", ",", "m_", ",", "\[Theta]", ",", "\[Phi]"}], 
     "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{
        SqrtBox["2"], "r"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"#", ",", "\[Theta]"}], "]"}], "+", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"Csc", "[", "\[Theta]", "]"}], 
         RowBox[{"D", "[", 
          RowBox[{"#", ",", "\[Phi]"}], "]"}]}], "-", 
        RowBox[{"s", " ", 
         RowBox[{"Cot", "[", "\[Theta]", "]"}], "#"}]}], ")"}]}], "&"}], "@", 
    
    RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
     RowBox[{
     "s", ",", "\[ScriptL]", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Eth]p", "[", 
    RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
     RowBox[{
     "s_", ",", "\[ScriptL]_", ",", "m_", ",", "\[Theta]", ",", "\[Phi]"}], 
     "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{
        SqrtBox["2"], "r"}]], 
      RowBox[{"(", 
       RowBox[{
