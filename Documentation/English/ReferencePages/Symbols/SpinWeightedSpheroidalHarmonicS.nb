 CellID->1999369011,ExpressionUUID->"1c4ef8ff-f73c-4a44-801b-ffc865c09979"],

Cell["\<\
For Methods that support suboptions, they may be passed as a list. For \
example Method \[Rule] {\"Leaver\", \"NumTerms\" \[Rule] 10} sets the \
\"NumTerms\" suboption to have value 10.\
\>", "Notes",
 CellChangeTimes->{
  3.893617221784797*^9, {3.89378445311784*^9, 3.893784461094114*^9}},
 CellID->617218881,ExpressionUUID->"4526799f-f8a6-450f-8912-b6ee7eedc31f"],

Cell["\<\
The possible suboptions that the \"Leaver\" method accepts are: \"NumTerms\" \
\[Rule] n.\
\>", "Notes",
 CellChangeTimes->{{3.89361722765359*^9, 3.893617235363677*^9}, {
   3.893784345796798*^9, 3.893784366565734*^9}, {3.893784448381419*^9, 
   3.893784451240842*^9}, 3.89400403829182*^9},
 CellID->1251717957,ExpressionUUID->"11a4489f-b48c-4ca4-887b-9c418d8d85c9"],

Cell["\<\
The possible suboptions that the \"SphericalExpansion\" method accepts are: \
\"NumTerms\" \[Rule] n.\
\>", "Notes",
 CellChangeTimes->{3.89361724011123*^9},
 CellID->951040776,ExpressionUUID->"af08c12e-9e02-44cd-844a-82d1240012c2"]
}, Open  ]],

