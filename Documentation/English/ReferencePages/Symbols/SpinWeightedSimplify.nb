Cell["\<\
We can evaluate \[Theta] derivatives via spin raising and lowering. \
\>", "ExampleText",
 CellChangeTimes->{{3.997248598748497*^9, 3.997248633447486*^9}},
 CellID->2045865683,ExpressionUUID->"928983ef-88b1-493b-8617-3e02b784de5c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
   RowBox[{
    RowBox[{"-", "2"}], ",", "2", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
   "]"}], "//", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{"#", ",", "\[Theta]"}], "]"}], "&"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "//", "SpinWeightedSimplify"}], "//", "Simplify"}]}], "Input",
 CellChangeTimes->{{3.997248527467531*^9, 3.997248555505196*^9}},
 CellLabel->"In[8]:=",
 CellID->541924597,ExpressionUUID->"55c9a29a-126a-4a93-9d20-f9d3adb477af"],

Cell[BoxData[
 InterpretationBox[
  TagBox[
   TemplateBox[{
     RowBox[{"-", "2"}], "2", "m", "\[Theta]", "\[Phi]", "1", "0"},
    "MyCustomBox",
    DisplayFunction->(StyleBox[
      FrameBox[
       RowBox[{
         SubscriptBox["", #], 
         SubsuperscriptBox["Y", 
          RowBox[{#2, "", #3}], 
          RowBox[{"(", #6, ",", #7, ")"}]], 
         RowBox[{"[", #4, ",", #5, "]"}]}], Background -> None, FrameStyle -> 
       None, RoundingRadius -> 4, FrameMargins -> {{0, 1}, {0, 0}}]]& )],
   DisplayForm],
  Derivative[0, 0, 0, 1, 0][
  SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY][-2, 
   2, $CellContext`m, $CellContext`\[Theta], $CellContext`\[Phi]]]], "Output",\

 CellChangeTimes->{{3.9972485353482523`*^9, 3.997248555749199*^9}},
 CellLabel->"Out[8]=",
 CellID->249536683,ExpressionUUID->"e8f967d7-31e5-476d-b296-daae82dcd744"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SqrtBox[
    FractionBox["3", "2"]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "m"}], "+", 
     RowBox[{"2", " ", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], " ", 
   RowBox[{"Csc", "[", "\[Theta]", "]"}], " ", 
   RowBox[{"SphericalHarmonicY", "[", 
    RowBox[{"2", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["m", "2"], "-", 
     RowBox[{"3", " ", "m", " ", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
     RowBox[{"2", " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "\[Theta]"}], "]"}]}]}], ")"}], " ", 
   SuperscriptBox[
    RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], " ", 
   InterpretationBox[
    TagBox[
     TemplateBox[{
       RowBox[{"-", "1"}], "2", "m", "\[Theta]", "\[Phi]"},
      "MyCustomBox",
      DisplayFunction->(StyleBox[
        FrameBox[
         RowBox[{
           SubscriptBox["", #], 
           SubscriptBox["Y", 
            RowBox[{#2, " ", #3}]], 
           RowBox[{"[", #4, ",", #5, "]"}]}], Background -> None, FrameStyle -> 
         None, RoundingRadius -> 4, FrameMargins -> {{0, 1}, {0, 0}}]]& )],
     DisplayForm],
    SpinWeightedSpheroidalHarmonics`SpinWeightedSphericalHarmonicY[-1, 
     2, $CellContext`m, $CellContext`\[Theta], $CellContext`\[Phi]]]}]}]], \
"Output",
 CellChangeTimes->{{3.9972485353482523`*^9, 3.9972485559321337`*^9}},
 CellLabel->"Out[9]=",
 CellID->244679970,ExpressionUUID->"fc78e4e2-87d6-4bec-bb84-59114bd3b5b3"]
}, Open  ]],

