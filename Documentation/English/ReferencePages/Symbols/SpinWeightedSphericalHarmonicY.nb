  SuperscriptBox["\[ExponentialE]", 
   FractionBox[
    RowBox[{"3", " ", "\[ImaginaryI]", " ", "\[Phi]"}], "2"]], " ", 
  SqrtBox[
   FractionBox["3", "\[Pi]"]], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], "2"], " ", 
  RowBox[{"(", 
   RowBox[{"1", "+", 
    RowBox[{"5", " ", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], " ", 
  RowBox[{"Cot", "[", 
   FractionBox["\[Theta]", "2"], "]"}], " ", 
  RowBox[{"Csc", "[", 
