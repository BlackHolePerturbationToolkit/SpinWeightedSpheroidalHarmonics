    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"l", "+", "m"}]], 
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", 
      RowBox[{"-", "s"}]], 
     SubscriptBox["S", 
      RowBox[{"l", "m"}]]}], 
    RowBox[{"(", 
