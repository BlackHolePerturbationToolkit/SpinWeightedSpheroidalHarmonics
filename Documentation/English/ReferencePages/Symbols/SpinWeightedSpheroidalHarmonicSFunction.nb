Cell[TextData[{
 "A ",
 Cell[BoxData[
  ButtonBox["SpinWeightedSpheroidalHarmonicSFunction",
   BaseStyle->"Link",
   ButtonData->
    "paclet:SpinWeightedSpheroidalHarmonics/ref/\
SpinWeightedSpheroidalHarmonicSFunction"]], "InlineFormula",ExpressionUUID->
  "9d19d780-8c34-432c-8a54-9b6a214f1171"],
