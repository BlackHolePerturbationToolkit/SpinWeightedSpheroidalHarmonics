Cell["\<\
We can evaluate \[Theta] derivatives via spin raising and lowering. \
\>", "ExampleText",
 CellChangeTimes->{{3.997248598748497*^9, 3.997248633447486*^9}},
 CellID->2045865683,ExpressionUUID->"928983ef-88b1-493b-8617-3e02b784de5c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
   RowBox[{
    RowBox[{"-", "2"}], ",", "2", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
   "]"}], "//", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{"#", ",", "\[Theta]"}], "]"}], "&"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "//", "SpinWeightedSimplify"}], "//", "Simplify"}]}], "Input",
 CellChangeTimes->{{3.997248527467531*^9, 3.997248555505196*^9}},
