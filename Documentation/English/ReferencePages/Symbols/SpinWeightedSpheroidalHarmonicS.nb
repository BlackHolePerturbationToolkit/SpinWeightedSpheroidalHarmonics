         RowBox[{"{", 
          RowBox[{"\[Gamma]", ",", "0", ",", "4"}], "}"}]}], "]"}], "&"}]}], 
     ",", "\"\<Slow Series\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
