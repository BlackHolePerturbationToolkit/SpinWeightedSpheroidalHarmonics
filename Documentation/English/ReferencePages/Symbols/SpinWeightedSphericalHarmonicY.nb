 ", ",
 Cell[BoxData[
 "l"], "InlineFormula",ExpressionUUID->"7fccafb9-aa27-4f96-80d1-b13cb61f15c5"],
 " and ",
 Cell[BoxData[
 "m"], "InlineFormula",ExpressionUUID->"7fdb7dc6-6996-4b45-a025-8f201df19b61"],
 ":"
}], "ExampleText",
