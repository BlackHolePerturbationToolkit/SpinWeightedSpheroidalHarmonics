Cell["\<\
We can use ToSpinWeight to express a SpinWeightedSphericalHarmonicY in terms \
of another spin weight\
\>", "ExampleText",
 CellChangeTimes->{{3.99018150942558*^9, 3.9901815361927643`*^9}},
 CellID->1494604772,ExpressionUUID->"b27435a1-e43d-4a21-825f-0bb06513d6be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
   RowBox[{
    RowBox[{"-", "2"}], ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
   "]"}], "//", 
  RowBox[{
   RowBox[{"ToSpinWeight", "[", 
    RowBox[{"#", ",", 
     RowBox[{"-", "4"}]}], "]"}], "&"}]}]], "Input",
 CellChangeTimes->{{3.990181460912106*^9, 3.9901814908623333`*^9}},
 CellLabel->"In[70]:=",
 CellID->2024601593,ExpressionUUID->"85a15d89-29fb-4b5f-9c83-5f49ad3dca75"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   SqrtBox[
    RowBox[{
     RowBox[{"-", "6"}], "+", "l", "+", 
     SuperscriptBox["l", "2"]}]]], 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      SqrtBox[
       RowBox[{
        RowBox[{"-", "12"}], "+", "l", "+", 
        SuperscriptBox["l", "2"]}]]}], " ", 
     RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
      RowBox[{
       RowBox[{"-", "4"}], ",", "l", ",", "m", ",", "\[Theta]", ",", 
       "\[Phi]"}], "]"}]}], "+", 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"m", "-", 
       RowBox[{"3", " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], " ", 
     RowBox[{"Csc", "[", "\[Theta]", "]"}], " ", 
     RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "l", ",", "m", ",", "\[Theta]", ",", 
       "\[Phi]"}], "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.990181473513206*^9, 3.990181491186743*^9}},
 CellLabel->"Out[70]=",
 CellID->960981644,ExpressionUUID->"26bd2c2d-d036-4d6e-bc44-9c0f76ccc5c9"]
}, Open  ]],

Cell["\<\
By default it will automatically map spin weight 1 onto spin weight 0 with a \
different m mode \
\>", "SeeAlso",
 CellChangeTimes->{{3.990181554631309*^9, 3.990181605056198*^9}},
 CellID->664689282,ExpressionUUID->"5bbba3b1-b590-4c82-92dd-8d5a9225c7ee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
   RowBox[{
    RowBox[{"-", "2"}], ",", "l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
   "]"}], "//", 
  RowBox[{
   RowBox[{"ToSpinWeight", "[", 
    RowBox[{"#", ",", "0"}], "]"}], "&"}]}]], "Input",
 CellChangeTimes->{{3.990181548048592*^9, 3.9901815490301123`*^9}},
 CellLabel->"In[71]:=",
 CellID->159455147,ExpressionUUID->"51bf3a7c-0c41-4a4d-92e2-0c60ff32f682"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   SqrtBox[
    RowBox[{
     RowBox[{"-", "2"}], "+", "l", "+", 
     SuperscriptBox["l", "2"]}]]], 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      SqrtBox[
       RowBox[{"l", "+", 
        SuperscriptBox["l", "2"]}]]}], " ", 
     RowBox[{"SphericalHarmonicY", "[", 
      RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}], "+", 
    RowBox[{
     FractionBox["1", 
      SqrtBox[
       RowBox[{"l", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "l"}], ")"}]}]]], 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{"m", "-", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], " ", 
      RowBox[{"Csc", "[", "\[Theta]", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"m", " ", 
         RowBox[{"Cot", "[", 
          FractionBox["\[Theta]", "2"], "]"}], " ", 
         RowBox[{"SphericalHarmonicY", "[", 
          RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}], 
        "+", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Phi]"}]], " ", 
         SqrtBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"l", "-", "m"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "l", "+", "m"}], ")"}]}]], " ", 
         RowBox[{"SphericalHarmonicY", "[", 
          RowBox[{"l", ",", 
           RowBox[{"1", "+", "m"}], ",", "\[Theta]", ",", "\[Phi]"}], 
          "]"}]}]}], ")"}]}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.9901815492803373`*^9},
 CellLabel->"Out[71]=",
 CellID->350046424,ExpressionUUID->"c2e69d4a-e643-4fa3-9ec2-78bc32185480"]
}, Open  ]],

